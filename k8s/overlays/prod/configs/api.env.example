port=3000
cors_allowed_origins=https://dialectlibrary.com,https://www.dialectlibrary.com,https://labs.dialectlibrary.com,https://stream.dialectlibrary.com,https://community.dialectlibrary.com,https://kyc.dialectlibrary.com
redis_host=redis
redis_port=6379
rabbitmq_host=rabbitmq
rabbitmq_port=5672
rabbitmq_vhost=/dialectiva
spaces_region=sfo3
spaces_submissions_bucket=dialectiva-submissions
spaces_word_recordings_bucket=dialectiva-word-recordings
spaces_blog_media_bucket=dialectiva-blog-media
spaces_course_media_bucket=dialectiva-course-media
spaces_marketing_bucket=dialectiva-marketing
spaces_community_bucket=dialectiva-community
spaces_p2p_chat_bucket=dialectiva-p2p-chat
spaces_payment_method_logo_bucket=dialectiva-payment-method-logos
spaces_kyc_evidence_bucket=dialectiva-kyc-evidence
spaces_testimony_bucket=dialectiva-testimonials
access_token_ttl=15m
frontend_url=https://dialectlibrary.com
stream_frontend_url=https://stream.dialectlibrary.com
# Connect webinar site -- where speaker photo-upload links point.
connect_frontend_url=https://connect.dialectlibrary.com
kyc_app_url=https://kyc.dialectlibrary.com
resend_from_address=noreply@dialectlibrary.com
token_usd_rate=0.10
min_withdrawal_tokens=50
api_public_base_url=https://api.dialectlibrary.com
# Repository receiving admin-created AI assistant backlog issues.
# Format: owner/repository. Leave blank to keep the feature disabled.
github_repository=
livekit_url=wss://livekit.dialectlibrary.com

# VDCL licence documents (PDF licence + PNG certificate). Must be PRIVATE --
# a licence PDF names a real contributor. Served only via short-lived
# presigned URLs to the contributor and authorised staff.
spaces_vdcl_documents_bucket=dialectiva-vdcl-documents
