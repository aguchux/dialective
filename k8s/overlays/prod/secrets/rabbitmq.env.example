# Copy to rabbitmq.env (gitignored) and replace both values before applying.
# This account is used only for the RabbitMQ management UI and future in-cluster
# AMQP clients. Use a unique username and a high-entropy password; never use
# the built-in guest account or reuse application/admin credentials.
username=dialectiva-rabbitmq-admin
password=replace-with-a-long-random-password
