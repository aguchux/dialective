# Copy to whatsapp-crypto.env (gitignored) and fill in a real value.
# Backs the whatsapp-crypto-creds k8s Secret, consumed by api's
# whatsapp-crypto.util.ts to AES-256-GCM encrypt the MailerSend API key at
# rest on PlatformSettings.whatsappApiKeyEncrypted.
#
# Deliberately a SEPARATE key from kyc-crypto.env/payout-crypto.env -- a
# leaked MailerSend key should not also expose KYC/payout secrets, and vice
# versa (different blast radius/rotation lifecycle).
# Generate with: openssl rand -base64 32
whatsapp_settings_encryption_key=changeme
