# Copy to vdcl.env (gitignored) and fill in a real value.
# Backs the vdcl-creds k8s Secret, consumed by api's
# vdcl/documents/verification-token.util.ts.
#
# This key signs the QR verification tokens printed on VDCL licence
# certificates. It is what stops someone printing their own certificate
# whose QR points at a licence id they invented, or editing the metrics on
# a real one and re-encoding it -- without a valid signature the public
# verification endpoint refuses to confirm anything.
#
# Rotating it INVALIDATES every certificate already in the world, since
# their printed QR codes were signed with the old key. Treat a rotation as
# a re-issue of every active licence, not a routine credential change.
#
# Deliberately separate from the auth/kyc/payout keys: different blast
# radius (a leak forges certificates, it does not expose PII or move money)
# and a very different rotation lifecycle.
# Generate with: openssl rand -base64 32
vdcl_verification_secret=changeme
