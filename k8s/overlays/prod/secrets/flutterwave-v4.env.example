# Copy to flutterwave-v4.env (gitignored) and fill in real values.
# Backs the flutterwave-v4-creds k8s Secret, consumed by api's wallet/
# module (FlutterwaveV4Service) for Flutterwave's current (v4) API --
# OAuth2 Customer/PaymentMethod/Charge funding and Recipient/Sender/
# Transfer payouts, kept as a separate service from FlutterwaveService's
# v3 hosted-checkout-link rail (see PlatformSettings.isFlutterwaveV4Enabled,
# off by default -- v3 stays the active rail until this is explicitly
# enabled).
#
# Get from your Flutterwave dashboard, under the v4/current API
# credentials section (not the same client_id/client_secret as the legacy
# v3 secret key above -- v4 uses OAuth2 client-credentials, not a static
# Bearer key).
flutterwave_v4_client_id=changeme
flutterwave_v4_client_secret=changeme

# Webhook signing secret for the v4 webhook (flutterwave-signature header,
# HMAC-SHA256 over the raw body) -- register the callback URL for this
# separately from the v3 webhook:
# https://api.dialectlibrary.com/api/v1/wallet/webhooks/flutterwave-v4
flutterwave_v4_webhook_secret_hash=changeme

# Unlike v3 (one API base URL, key prefix alone decides sandbox vs. live),
# v4 uses genuinely different base URLs for each environment. Kept here
# (not hardcoded in k8s/base/*.yaml) so each overlay's copy of this file
# controls it independently:
#   sandbox: https://developersandbox-api.flutterwave.com
#   live:    https://f4bexperience.flutterwave.com
flutterwave_v4_base_url=https://developersandbox-api.flutterwave.com
