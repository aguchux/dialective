# Copy to discourse.env (gitignored) and fill in real values.
# Backs the discourse-creds k8s Secret.

# Discourse's own bootstrap admin account (created on first boot). Use this
# only for break-glass access -- everyday admin/moderator access comes
# through DiscourseConnect SSO (see discourse_sso_secret below), driven by
# each user's role in the main app.
admin_username=admin
admin_password=changeme
admin_email=admin@dialectlibrary.com

# SMTP creds for Discourse's own outbound mail (digests, notifications) --
# can reuse Resend's SMTP credentials (resend.com -> API Keys -> SMTP) or any
# other provider; independent of api's own resend_api_key in auth.env.
smtp_user=changeme
smtp_password=changeme

# Shared HMAC-SHA256 secret for DiscourseConnect (SSO). Must match
# frontend's DISCOURSE_SSO_SECRET (Vercel env var) exactly -- a mismatch
# makes every SSO login fail signature verification. Generate with
# `openssl rand -hex 32`.
sso_secret=changeme
