# Copy to sms.env (gitignored) and fill in real values.
# Backs the sms-creds k8s Secret, consumed by services/api's SmsFallbackChain
# (TwilioProvider/TermiiProvider/AfricasTalkingProvider/Smslive247Provider)
# for PHONE_VERIFICATION OTP delivery. Like llm.env, each provider's keys are
# only required if that provider is actually selected in admin Settings ->
# smsProviderOrder -- a missing/placeholder key just makes that provider
# fail-and-fall-back to the next one in the chain rather than error the
# whole request, so it's safe to leave any of these as "changeme" if you
# don't intend to use that provider.
#
# twilio_account_sid / twilio_auth_token / twilio_from_number: console.twilio.com
# termii_api_key / termii_sender_id: accounts.termii.com/api-keys
# africastalking_api_key / africastalking_username / africastalking_sender_id: account.africastalking.com
# smslive247_api_key / smslive247_sender_id: dashboard Account Details -> Developer API Key (smslive247.com)
# smslive247_route_id: optional transactional route ID from SMSLive247. Leave blank to use the provider default route.
twilio_account_sid=changeme
twilio_auth_token=changeme
twilio_from_number=changeme
termii_api_key=changeme
termii_sender_id=changeme
africastalking_api_key=changeme
africastalking_username=changeme
africastalking_sender_id=changeme
smslive247_api_key=changeme
smslive247_sender_id=changeme
smslive247_route_id=
