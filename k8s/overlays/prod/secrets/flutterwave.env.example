# Copy to flutterwave.env (gitignored) and fill in real values.
# Backs the flutterwave-creds k8s Secret, consumed by api's wallet/ module
# (FlutterwaveService) for fiat (bank transfer + mobile money) funding and
# trainer payouts -- the fiat rail alongside NOWPayments' stablecoin rail.
#
# Get from your Flutterwave dashboard (dashboard.flutterwave.com), under
# Settings -> API. Test keys are prefixed FLWSECK_TEST-/FLWPUBK_TEST-, live
# keys are unprefixed -- both use the same API base URL
# (https://api.flutterwave.com/v3), the key prefix alone determines
# sandbox vs. live behavior. flutterwave_environment below is informational
# only (surfaced in logs/admin UI), not something the code branches on.
flutterwave_secret_key=changeme
flutterwave_public_key=changeme

# Settings -> Webhooks -> Secret Hash. Flutterwave's documentation is
# inconsistent across versions about which header carries the webhook
# signature (legacy verif-hash: plain string compare; newer
# flutterwave-signature: HMAC-SHA256 of the raw body, base64) -- both are
# keyed by this same secret hash, and FlutterwaveService.verifyWebhookSignature
# checks both, accepting either. Register the webhook callback URL in the
# same Settings -> Webhooks page:
# https://api.dialectlibrary.com/api/v1/wallet/webhooks/flutterwave
flutterwave_webhook_secret_hash=changeme

# sandbox | production -- informational only, does not change the API base
# URL (see above); useful for admin UI display and log filtering.
flutterwave_environment=sandbox
