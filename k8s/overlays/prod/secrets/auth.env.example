# Copy to auth.env (gitignored) and fill in real values.
# Backs the auth-creds k8s Secret.

# Signs api's short-lived access tokens (services/api/src/auth/jwt.util.ts).
jwt_access_secret=changeme
# Authenticates server-to-server calls from frontend's NextAuth callback to
# api's /auth/magic-link/callback (never sent from a browser) -- shared
# between api and frontend, must match exactly.
oauth_callback_secret=changeme
# Encrypts NextAuth's own session JWT (Vercel-hosted frontend only).
nextauth_secret=changeme
# Resend API key (resend.com -> API Keys) -- used by api's MailService to send
# password-reset/email-verification/magic-link emails from noreply@dialectlibrary.com.
resend_api_key=changeme
# Passphrase used to derive the AES-256-GCM key for ApiAccessToken.encryptedValue
# (services/api/src/common/token-crypto.util.ts / whisper-worker's token_crypto.py).
# Must be identical for api and whisper-worker -- a mismatch makes every
# admin-saved token (e.g. the Hugging Face token) undecryptable. Generate with
# `openssl rand -base64 32`; rotating this value invalidates every token
# already saved via Admin Settings > API Access Tokens (they'd need re-saving).
api_token_encryption_key=changeme
# Fine-grained GitHub token with Issues: Read and write permission for the
# backlog repository. The API uses this only for admin-created issues.
github_issues_token=changeme
