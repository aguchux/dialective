# Copy to auth.env (gitignored) and fill in real values.
# Backs the auth-creds k8s Secret.

# Signs api's short-lived access tokens (services/api/src/auth/jwt.util.ts).
jwt_access_secret=changeme
# Authenticates server-to-server calls from frontend's NextAuth callbacks to
# api's /auth/oauth-callback and /auth/magic-link/callback (never sent from a
# browser) -- shared between api and frontend, must match exactly.
oauth_callback_secret=changeme
# Encrypts NextAuth's own session JWT (Vercel-hosted frontend only).
nextauth_secret=changeme
# Google OAuth app credentials (console.cloud.google.com -> APIs & Services -> Credentials).
google_client_id=changeme
google_client_secret=changeme
# Resend API key (resend.com -> API Keys) -- used by api's MailService to send
# password-reset/email-verification/magic-link emails from noreply@nmseprep.com.
resend_api_key=changeme
