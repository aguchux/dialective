# Copy to coinbase.env (gitignored) and fill in real values.
# Backs the coinbase-creds k8s Secret, consumed by api's wallet/ module
# (CoinbaseCommerceService) for USDC/USDT deposit checkout + webhook
# verification. Get both from the Coinbase Commerce dashboard
# (commerce.coinbase.com/settings) -- api_key under API keys, webhook_secret
# under Webhook subscriptions (create one pointed at
# https://api.nmseprep.com/api/v1/wallet/webhooks/coinbase, event type
# charge:confirmed).
coinbase_commerce_api_key=changeme
coinbase_commerce_webhook_secret=changeme
