# Copy to google-analytics.env (gitignored) and fill in real values.
# Backs the google-analytics-creds k8s Secret, consumed by
# google-analytics-job (services/google-analytics-job) to pull traffic
# data from the GA4 Data API on a schedule -- see
# k8s/base/google-analytics-cronjob.yaml. Both keys are optional at the
# k8s manifest level (secretKeyRef ... optional: true) so this CronJob can
# be applied and scheduled before either is set; the job just logs and
# exits 0 until both are present.
#
# The numeric GA4 Property ID, from GA4 Admin -> Property Settings --
# NOT the "G-XXXXXXXXXX" Measurement ID already configured in
# Admin -> Settings -> Analytics & Metrics (different value, same property).
property_id=changeme

# A GCP service account JSON key with Viewer access granted on the GA4
# property (GA4 Admin -> Property Access Management -> add the service
# account's ...@...iam.gserviceaccount.com email as Viewer). Paste the
# entire downloaded key file's JSON as ONE LINE (minified, no literal
# newlines) -- this is a `key=value` .env file, so a literal newline
# inside the value breaks parsing. Any JSON minifier, or
# `jq -c . key.json`, produces a safe single-line value.
service_account_json=changeme
