# Copy to kyc-crypto.env (gitignored) and fill in a real value.
# Backs the kyc-crypto-creds k8s Secret, consumed by api's kyc-crypto.util.ts
# to AES-256-GCM encrypt the full Didit decision payload (document number,
# name, DOB) at rest on KycVerification.decisionEncryptedJson.
#
# Deliberately a SEPARATE key from payout-crypto.env's
# PAYOUT_ACCOUNT_ENCRYPTION_KEY -- a leaked payout-account key should not
# also expose ID document PII (different blast radius/rotation lifecycle).
# Generate with: openssl rand -base64 32
kyc_document_encryption_key=changeme
