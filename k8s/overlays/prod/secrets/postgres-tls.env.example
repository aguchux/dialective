# NOT a plain secretGenerator env file -- same reasoning as redis-tls.env.
# Created directly via `kubectl create secret tls`, not kustomize.
#
# Self-managed cert, separate from redis-tls's cert so each is
# independently rotatable. Generate once:
#   openssl req -x509 -newkey rsa:4096 -nodes \
#     -keyout tls.key -out tls.crt -days 3650 \
#     -subj "/CN=postgres-external.dai.internal"
#
# Then create the k8s Secret directly (namespace dai):
#   kubectl create secret tls postgres-tls \
#     --cert=tls.crt --key=tls.key --namespace dai
#
# Keep tls.crt somewhere safe -- k8s/gcp-cloud/overlays/prod/secrets/ needs
# a copy of it (as PGSSLROOTCERT via the postgres.env's connection_string
# sslrootcert parameter) so vosk-worker on GCP can validate the server's
# identity against this specific cert.
