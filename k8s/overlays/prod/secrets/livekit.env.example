# Copy to livekit.env (gitignored) and fill in real values.
# Backs the livekit-creds k8s Secret, consumed by:
#   - livekit-server itself (LIVEKIT_KEYS, JSON map form of its `keys:`
#     config block -- see k8s/base/livekit-deployment.yaml)
#   - services/api's ChatDialectController (mints room-join tokens)
#   - chatdialect-agent (joins rooms as a worker)
# api_key/api_secret must be a matching pair; api_secret should be a long
# random string (e.g. `openssl rand -base64 32`), not reused from any other
# credential in this repo.
api_key=changeme
api_secret=changeme
# JSON map form: {"<api_key>": "<api_secret>"} -- must match the two values
# above exactly. LiveKit supports multiple key/secret pairs in this map;
# this repo only needs one.
livekit_keys_json={"changeme": "changeme"}
