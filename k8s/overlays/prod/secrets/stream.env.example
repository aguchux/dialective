# Copy to stream.env (gitignored) and fill in real values.
# Backs the stream-creds k8s Secret -- Dialect Library Voice Stream
# (docs/Dialect_Library_Voice_Stream_ISVP_ISVC_Plan.md) subscriber auth and
# Stripe billing. Deliberately separate from auth-creds -- Voice Stream is a
# fully separate tenant/security boundary from the trainer-facing platform.

# Signs Voice Stream subscriber access tokens
# (services/api/src/voice-stream/subscriber-auth/subscriber-jwt.util.ts).
# Must differ from auth-creds' jwt_access_secret.
stream_jwt_access_secret=changeme

# Stripe secret key (dashboard.stripe.com -> Developers -> API keys) --
# used by BillingService to create Checkout sessions and Customers.
stripe_secret_key=changeme

# Stripe webhook signing secret (dashboard.stripe.com -> Developers ->
# Webhooks -> the endpoint for
# https://api.dialectlibrary.com/api/v1/voice-stream/billing/webhooks/stripe)
# -- verifies stripe.webhooks.constructEvent's signature.
stripe_webhook_secret=changeme

# Stripe Price ids for each SubscriptionPlan.key seeded in the Voice Stream
# schema ("starter" | "professional" | "enterprise") -- created under
# Stripe Products, recurring monthly.
stripe_price_id_starter=changeme
stripe_price_id_professional=changeme
stripe_price_id_enterprise=changeme
