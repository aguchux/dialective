# Copy to nowpayments.env (gitignored) and fill in real values.
# Backs the nowpayments-creds k8s Secret, consumed by api's wallet/ module
# (NowPaymentsService) for USDC/USDT deposit invoices + IPN webhook
# verification.
#
# Get both from your NOWPayments dashboard (account.nowpayments.io):
# - api_key: Settings -> API keys
# - ipn_secret: Settings -> Payment settings -> IPN Secret Key (also where
#   you register the callback URL, though api sends ipn_callback_url on
#   every invoice creation request too, which takes precedence per-invoice)
#
# Chosen over Coinbase Commerce because Coinbase Commerce/Business does not
# onboard UK merchants -- see AGENTS.md "Wallet / token pool".
nowpayments_api_key=changeme
nowpayments_ipn_secret=changeme
