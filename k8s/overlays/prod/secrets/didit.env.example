# Copy to didit.env (gitignored) and fill in real values.
# Backs the didit-creds k8s Secret, consumed by api's kyc/ module
# (DiditService) for hosted ID-scan + selfie identity verification.
#
# Get from your Didit Console (console.didit.me), under API & Webhooks.
didit_api_key=changeme

# The workflow to run (Console -> Workflows) -- a single global workflow_id
# covers all countries for now; kyc.service.ts doesn't branch on user
# country. https://verification.didit.me/v3/session/ is called with this
# workflow_id on every kyc/session request.
didit_workflow_id=changeme

# Console -> API & Webhooks -> Webhook destination's secret_shared_key.
# Didit signs every webhook with three HMAC-SHA256 schemes keyed by this
# same secret (X-Signature-V2, X-Signature, X-Signature-Simple) --
# DiditService.verifyWebhookSignature checks all three, accepting any one.
# Register the webhook destination URL in the same Console page:
# https://api.dialectlibrary.com/api/v1/kyc/webhooks/didit
didit_webhook_secret=changeme
