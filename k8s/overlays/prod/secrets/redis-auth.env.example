# Copy to redis-auth.env (gitignored) and fill in a real generated value
# (e.g. `openssl rand -base64 32`).
# Backs the redis-auth k8s Secret. Used both by Redis itself (--requirepass)
# and by every consumer's REDIS_PASSWORD env var -- same value both places.
# See k8s/base/redis.yaml and k8s/gcp-cloud/README.md for the staged
# rollout order (deploy password-aware clients BEFORE setting requirepass).
password=changeme
