# Copy to llm.env (gitignored) and fill in real values.
# Backs the llm-creds k8s Secret, consumed by word-generator-job's fallback
# chain (OpenAiProvider/DeepSeekProvider/AnthropicProvider). All three keys
# are optional in the sense that the job only needs the providers actually
# selected in admin Settings -> Word Generation's provider order to work,
# but a missing key still makes that provider fail-and-fall-back rather
# than error the whole run -- so it's safe to leave any of these as
# "changeme" if you don't intend to use that provider.
#
# openai_api_key: platform.openai.com/api-keys
# deepseek_api_key: platform.deepseek.com/api_keys
# anthropic_api_key: console.anthropic.com/settings/keys
openai_api_key=changeme
deepseek_api_key=changeme
anthropic_api_key=changeme
