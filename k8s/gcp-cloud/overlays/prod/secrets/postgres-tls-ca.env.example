# Same pattern as redis-tls-ca.env.example, for the postgres-external cert:
#
#   kubectl create secret generic postgres-tls-ca \
#     --from-file=ca.crt=./postgres-tls.crt --namespace dai
#
# (./postgres-tls.crt is the SAME tls.crt generated in
# ../../../overlays/prod/secrets/postgres-tls.env.example's openssl step.)
