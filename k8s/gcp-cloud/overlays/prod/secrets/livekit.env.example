# Copy to livekit.env (gitignored). SAME values as DO's
# ../../../overlays/prod/secrets/livekit.env -- must be the exact same
# key/secret pair, since GCP's api mints tokens against the SAME
# livekit-server DO runs (livekit_url is the public wss://livekit.
# dialectlibrary.com host, see ../configs/api.env.example) -- a mismatched
# pair means every token GCP's api mints fails to join a room.
api_key=changeme
api_secret=changeme
livekit_keys_json={"changeme": "changeme"}
