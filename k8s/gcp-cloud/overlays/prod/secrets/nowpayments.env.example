# Copy to nowpayments.env (gitignored). SAME values as DO's
# ../../../overlays/prod/secrets/nowpayments.env -- one shared set of
# NOWPayments credentials, not per-cluster ones (see that file for what
# each key is/where to get it). This cluster's `api` cold-standby doesn't
# receive real traffic yet (see api-http-scaledobject.yaml), but every env
# var api-deployment.yaml references must resolve for the pod to start.
nowpayments_api_key=changeme
nowpayments_ipn_secret=changeme
nowpayments_payout_email=changeme
nowpayments_payout_password=changeme
