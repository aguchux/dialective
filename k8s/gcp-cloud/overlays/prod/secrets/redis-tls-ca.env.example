# NOT a plain secretGenerator env file -- this holds only the PUBLIC cert
# (ca.crt), which GCP's vosk-worker trusts to validate DO's Redis server
# identity. Created directly via kubectl, not kustomize:
#
#   kubectl create secret generic redis-tls-ca \
#     --from-file=ca.crt=./redis-tls.crt --namespace dai
#
# (./redis-tls.crt is the SAME tls.crt generated in
# ../../../overlays/prod/secrets/redis-tls.env.example's openssl step --
# copy it here, do not generate a new one, or GCP will trust a different
# cert than the one DO's Redis is actually presenting.)
