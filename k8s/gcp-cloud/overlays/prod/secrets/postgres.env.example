# Copy to postgres.env (gitignored). Same username/password as DO's
# ../../../overlays/prod/secrets/postgres.env (one shared database, not a
# per-cluster one), but the connection_string is DIFFERENT from DO's:
# points at postgres-external's LoadBalancer host (not the DO-internal
# `postgres` DNS name GCP can't resolve) and requires sslmode=require +
# sslrootcert pointed at the mounted postgres-tls-ca secret, since this
# connection leaves DO's cluster over the public internet.
username=dialectiva
password=changeme
connection_string=postgresql://dialectiva:changeme@REPLACE_WITH_POSTGRES_EXTERNAL_HOST:5432/dialectiva?sslmode=require&sslrootcert=/postgres-tls/ca.crt
