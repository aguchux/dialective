# Copy to auth.env (gitignored) and fill in the real value.
# Backs the auth-creds k8s Secret. Only api_token_encryption_key is needed
# here -- whisper-worker uses it to decrypt ApiAccessToken.encryptedValue
# (e.g. the Hugging Face token saved via Admin Settings > API Access
# Tokens). Must be IDENTICAL to the value in
# ../../../overlays/prod/secrets/auth.env -- a mismatch makes every
# admin-saved token undecryptable on this cluster's whisper-worker.
api_token_encryption_key=changeme
