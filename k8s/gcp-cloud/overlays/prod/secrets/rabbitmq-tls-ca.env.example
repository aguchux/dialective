# Same pattern as redis-tls-ca.env.example, for the rabbitmq-external cert:
#
#   kubectl create secret generic rabbitmq-tls-ca \
#     --from-file=ca.crt=./rabbitmq-tls.crt --namespace dai
#
# (./rabbitmq-tls.crt is the SAME tls.crt generated in
# ../../../overlays/prod/secrets/rabbitmq-tls.env.example's openssl step.)
