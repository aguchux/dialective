# Copy to api.env (gitignored).
# redis_host/redis_port and rabbitmq_host/rabbitmq_port point at DO's
# redis-external/rabbitmq-external LoadBalancers, NOT the DO-cluster-
# internal `redis`/`rabbitmq` hostnames used by ../../../overlays/prod's
# api.env -- GCP can't resolve or reach those internal DNS names.
# cors_allowed_origins/frontend_url/stream_frontend_url/api_public_base_url
# stay the SAME real public hostnames as DO's -- these aren't per-cluster,
# they're what the browser/frontend actually points at regardless of which
# cluster answers a given request.
port=3000
cors_allowed_origins=https://dialectlibrary.com,https://www.dialectlibrary.com,https://labs.dialectlibrary.com,https://stream.dialectlibrary.com,https://community.dialectlibrary.com
redis_host=REPLACE_WITH_REDIS_EXTERNAL_HOST
redis_port=6380
rabbitmq_host=REPLACE_WITH_RABBITMQ_EXTERNAL_HOST
rabbitmq_port=5671
rabbitmq_vhost=/dialectiva
spaces_region=sfo3
spaces_submissions_bucket=dialectiva-submissions
spaces_word_recordings_bucket=dialectiva-word-recordings
spaces_blog_media_bucket=dialectiva-blog-media
spaces_course_media_bucket=dialectiva-course-media
spaces_marketing_bucket=dialectiva-marketing
spaces_community_bucket=dialectiva-community
access_token_ttl=15m
frontend_url=https://dialectlibrary.com
stream_frontend_url=https://stream.dialectlibrary.com
resend_from_address=noreply@dialectlibrary.com
token_usd_rate=0.10
min_withdrawal_tokens=50
api_public_base_url=https://api.dialectlibrary.com
github_repository=
livekit_url=wss://livekit.dialectlibrary.com
