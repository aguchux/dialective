# Copy to whisper-worker.env (gitignored).
# redis_host/redis_port point at DO's redis-external LoadBalancer, NOT the
# DO-cluster-internal `redis`/6379 used by ../../../overlays/prod's
# whisper-worker.env -- GCP can't resolve or reach that internal DNS name.
# asr_stream/consumer_group are IDENTICAL to DO's -- that sameness is what
# makes this a shared queue, not a second separate one.
redis_host=REPLACE_WITH_REDIS_EXTERNAL_HOST
redis_port=6380
asr_stream=asr-jobs-whisper
consensus_stream=consensus-jobs
consumer_group=asr-workers-whisper
spaces_region=sfo3
