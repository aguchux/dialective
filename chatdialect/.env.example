# Copy to .env (gitignored) and fill in real values.
# See docs/CHATDIALECT_MVP_PLAN.md §38 -- do not require every provider
# simultaneously.

# LiveKit (self-hosted via infra/docker/docker-compose.yml for local dev --
# see that file's dev API key/secret; use different values in any shared
# environment). Read by services/api (mints tokens) and apps/agent (joins
# rooms as a worker) -- NOT by apps/web, which never holds the secret.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_at_least_32_characters_long

# LLM -- the one hosted-API provider in this plan (see plan's provider
# decisions: STT/TTS are self-hosted, LLM stays hosted since a capable
# self-hosted conversational LLM needs GPU infra this repo doesn't have).
OPENAI_API_KEY=

# Self-hosted STT/TTS checkpoints -- no API key needed. Open Whisper/MMS-TTS
# by default; swap to a Dialect Library checkpoint under test (e.g.
# NCAIR1/Igbo-ASR) to directly exercise it through a live conversation.
WHISPER_MODEL_CHECKPOINT=openai/whisper-small
MMS_TTS_CHECKPOINT=facebook/mms-tts-eng

# apps/web only -- where to reach the Dialect Library API (services/api)
# that mints LiveKit tokens (see services/api/src/chatdialect/). Point at
# http://localhost:3000/api/v1 for local dev against a locally-running
# services/api.
NEXT_PUBLIC_DIALECT_LIBRARY_API_URL=http://localhost:3000/api/v1

# Production value is https://labs.dialectlibrary.com (set on Vercel, not
# here -- this file's default is local-dev only).
NEXT_PUBLIC_APP_URL=http://localhost:3001
