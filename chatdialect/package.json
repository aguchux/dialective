{
  "name": "chatdialect",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "format": "npx prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\" && node ../scripts/format-python.mjs --agent-only",
    "format:check": "npx prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\" && node ../scripts/format-python.mjs --agent-only --check"
  }
}
