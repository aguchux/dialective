// api is the sole owner of this schema and all Postgres access in this repo
// (AGENTS.md "Database access" / "Authentication"). No other service touches
// Postgres directly, and no other service — including frontend/NextAuth
// — holds its own adapter or schema.

// Generated client output is redirected into packages/db so it's importable
// as @dialectiva/db by consensus-scorer and settlement-job without either
// service owning its own schema/migrations -- see AGENTS.md "Database
// access" and packages/db/README (if present) for why.
generator client {
  provider     = "prisma-client"
  output       = "../../../packages/db/src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TRAINER
  ADMIN
  PARTNER
  DISTRIBUTOR
  VALIDATOR
}

/// Internal-staff review tier for Role.VALIDATOR accounts only -- null for
/// every other role. L2 approves L1-submitted validator decks, L3 approves
/// L2-submitted decks; see docs/validators.md for the full approval chain.
enum ValidatorLevel {
  L1
  L2
  L3
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  // Self-service close-account. Distinct from BLOCKED/SUSPENDED (both
  // admin-driven, reversible) -- CLOSED is user-initiated and permanent from
  // the user's perspective; the account is soft-deleted (all refresh tokens
  // revoked immediately, login blocked) pending a later purge job.
  CLOSED
}

/// Administrator-assigned trainer quality label. The numeric order is kept
/// in application code so a public profile can present a compact badge while
/// the stored enum remains self-describing and constrained.
/// Admin-set quality label for a trainer, purely informational -- never
/// affects scoring or payouts. Ordered VERY_BAD (1 star) through EXCELLENT
/// (5 stars); see AuthService.trainerRatingValue for the numeric mapping
/// used by both the badge and the 5-star display.
enum TrainerRating {
  VERY_BAD
  BAD
  GOOD
  VERY_GOOD
  EXCELLENT
}

enum AuthProvider {
  CREDENTIALS
  EMAIL
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum ReferralInviteStatus {
  INVITED
  JOINED
}

model User {
  dykStates                     DykUserState[]
  id                            String          @id @default(uuid())
  firstName                     String?
  lastName                      String?
  email                         String          @unique
  passwordHash                  String? // null for OAuth/magic-link-only accounts
  role                          Role            @default(TRAINER)
  status                        UserStatus      @default(ACTIVE)
  trainerRating                 TrainerRating?
  trainerRatingUpdatedAt        DateTime?
  trainerRatingUpdatedById      String?
  trainerRatingUpdatedBy        User?           @relation("TrainerRatingUpdatedBy", fields: [trainerRatingUpdatedById], references: [id], onDelete: SetNull)
  trainerRatingsUpdated         User[]          @relation("TrainerRatingUpdatedBy")
  // Meaningful only when role = VALIDATOR; null for every other role.
  // App-level invariant (enforced in service/DTO, not DB): assigning
  // Role.VALIDATOR requires validatorLevel to be set, defaulting new
  // validators to L1. See docs/validators.md.
  validatorLevel                ValidatorLevel?
  validatorLevelUpdatedAt       DateTime?
  validatorLevelUpdatedById     String?
  validatorLevelUpdatedBy       User?           @relation("ValidatorLevelUpdatedBy", fields: [validatorLevelUpdatedById], references: [id], onDelete: SetNull)
  validatorLevelsUpdated        User[]          @relation("ValidatorLevelUpdatedBy")
  validatorDecksCreated         ValidatorDeck[] @relation("ValidatorDeckCreatedBy")
  validatorDecksOwned           ValidatorDeck[] @relation("ValidatorDeckOwner")
  // Automatic compliance hold, distinct from `status` (admin-driven
  // suspend/block) -- set by WordsService.createRecording the moment a
  // trainer's lifetime WordRecording count crosses a multiple of
  // PlatformSettings.auditHoldEveryNSubmissions. Blocks new word-training
  // assignments (see WordsService.nextAssignment) until an admin reviews
  // the trainer's recent work and explicitly releases the hold -- see
  // auditHoldReleasedAt/By below. Re-triggers at every next multiple of the
  // threshold regardless of how many holds/releases happened before it.
  auditHoldAt                   DateTime?
  auditHoldReleasedAt           DateTime?
  auditHoldReleasedById         String?
  auditHoldReleasedBy           User?           @relation("AuditHoldReleasedBy", fields: [auditHoldReleasedById], references: [id], onDelete: SetNull)
  auditHoldReleases             User[]          @relation("AuditHoldReleasedBy")
  emailVerified                 DateTime?
  phoneNumber                   String?         @unique // E.164 international format, e.g. "+2348012345678"
  phoneVerifiedAt               DateTime?
  // HMAC of the DIDIT-approved identity document. It is never returned by
  // the API and makes a second approval for the same identity impossible.
  diditIdentityFingerprint      String?         @unique
  // Denormalized read-cache of the latest resolved KycVerification (the
  // KycVerification table is the source of truth/history) -- lets
  // wallet.controller.ts's withdrawal gate check identity status without a
  // join on every request.
  kycStatus                     KycStatus       @default(NOT_STARTED)
  kycVerifiedAt                 DateTime?
  // Flutterwave v4 Customer id (POST /customers), created lazily on this
  // user's first v4 funding attempt -- see FlutterwaveV4Service.createCustomer.
  // Null for every user until the v4 rail is used at least once; unrelated to
  // v3's stateless per-request customer object.
  flutterwaveCustomerId         String?
  emailNotificationsEnabled     Boolean         @default(true)
  smsNotificationsEnabled       Boolean         @default(true)
  // Login 2FA channel toggles -- both off by default (see the doc comment on
  // AuthService.login: every login used to unconditionally email an OTP,
  // which was spamming the transactional mail system; login is now
  // password-only unless the user explicitly opts into one or both of these
  // in Security settings). SMS requires phoneVerifiedAt to already be set.
  twoFactorEmailEnabled         Boolean         @default(false)
  twoFactorSmsEnabled           Boolean         @default(false)
  marketingNotificationsEnabled Boolean         @default(false)
  blogNewsNotificationsEnabled  Boolean         @default(false)
  courseNotificationsEnabled    Boolean         @default(false)
  // Recorded after the browser confirms the PWA was installed. This is a
  // product-analytics marker only; it never grants access or changes auth.
  pwaInstalledAt                DateTime?
  // Country of origin is account identity data. It is distinct from
  // countryId below, which scopes the dialect/content the trainer works on.
  originCountryId               String?
  originCountry                 Country?        @relation("UserOriginCountry", fields: [originCountryId], references: [id])
  countryId                     String?
  country                       Country?        @relation(fields: [countryId], references: [id])
  dialectId                     String?
  dialect                       Dialect?        @relation(fields: [dialectId], references: [id])
  dialectVariantId              String? // optional sub-dialect (e.g. Izzi under Igbo) -- see DialectVariant. Never set without dialectId; enforced in AuthService.updateProfile, not at the schema level.
  dialectVariant                DialectVariant? @relation(fields: [dialectVariantId], references: [id])
  referralCode                  String          @unique // every user is a potential referrer; generated at registration
  referredById                  String?
  referredBy                    User?           @relation("Referrals", fields: [referredById], references: [id])
  referrals                     User[]          @relation("Referrals")
  // Set only when a DISTRIBUTOR promotes one of their own direct referrals
  // (referredById === promotedById at promotion time) to role=DISTRIBUTOR via
  // DistributorsService.promoteSubDistributor. Distinct from referredById: a
  // distributor can appear anywhere in another distributor's referral chain
  // without ever being promoted by them (buildDistributorReferralBonuses in
  // packages/db/src/payouts.ts walks referredById regardless of this field),
  // so promotedById is the actual ownership/authorization key for "may this
  // distributor fund/block/credit/debit that sub-distributor," never
  // referredById alone. Never cleared once set, even if status changes.
  promotedById                  String?
  promotedBy                    User?           @relation("SubDistributorPromotions", fields: [promotedById], references: [id])
  subDistributors               User[]          @relation("SubDistributorPromotions")
  // Global instructions shown to a P2P buyer alongside whichever of this
  // user's payment methods a trade uses (e.g. preferred payment window or
  // reference format) -- one note per user, not per payment method.
  p2pPaymentInstructions        String?
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt

  accounts                         LinkedAccount[]
  refreshTokens                    RefreshToken[]
  passwordResets                   PasswordResetToken[]
  emailVerifications               EmailVerificationToken[]
  otpCodes                         OtpCode[]
  manualPhoneVerificationRequests  ManualPhoneVerificationRequest[] @relation("ManualPhoneVerificationUser")
  manualPhoneVerificationsReviewed ManualPhoneVerificationRequest[] @relation("ManualPhoneVerificationAdmin")
  wallet                           Wallet?
  trainingPayoutClaims             TrainingPayoutClaim[]
  blogPosts                        BlogPost[]
  authoredCourses                  Course[]
  courseProgress                   CourseProgress[]
  trainingSessions                 TrainingSession[]
  wordRecordings                   WordRecording[]
  qracAffirmations                 QracAffirmationSubmission[]
  testimonies                      Testimony[]
  testimoniesEdited                Testimony[]                      @relation("TestimonyEditedBy")
  communityProfile                 CommunityProfile?
  communityPosts                   CommunityPost[]
  communityReplies                 CommunityReply[]
  communityReactions               CommunityReaction[]
  communityBookmarks               CommunityBookmark[]
  communityNotifications           CommunityNotification[]          @relation("CommunityNotificationRecipient")
  communityNotificationsActedOn    CommunityNotification[]          @relation("CommunityNotificationActor")
  communityReports                 CommunityReport[]                @relation("CommunityReportReporter")
  communityReportsAssigned         CommunityReport[]                @relation("CommunityReportAssignedModerator")
  communityModeratorActions        CommunityModeratorAction[]       @relation("CommunityModeratorActionModerator")
  marketingCampaignShares          MarketingCampaignShare[]
  marketingCampaignRegistration    MarketingCampaignRegistration?
  wordSkips                        WordSkip[]
  dataAccessLeadsContacted         DataAccessLead[]                 @relation("DataAccessLeadContactedBy")
  supportRequestsResolved          SupportRequest[]                 @relation("SupportRequestResolvedBy")
  p2pOffers                        P2PTokenOffer[]
  p2pBuyerTrades                   P2PTokenTrade[]                  @relation("P2PBuyerTrades")
  p2pSellerTrades                  P2PTokenTrade[]                  @relation("P2PSellerTrades")
  p2pDisputesRaised                P2PDispute[]                     @relation("P2PDisputesRaised")
  p2pDisputesResolved              P2PDispute[]                     @relation("P2PDisputesResolved")
  referralInvitesSent              ReferralInvite[]                 @relation("ReferralInvitesSent")
  referralInviteJoined             ReferralInvite[]                 @relation("ReferralInviteJoined")
  distributorAllocations           DistributorAllocation[]          @relation("DistributorAllocations")
  distributorAllocationsGranted    DistributorAllocation[]          @relation("DistributorAllocationsGranted")
  notifications                    UserNotification[]
  authoredSystemUpdates            SystemUpdate[]                   @relation("SystemUpdateAuthor")
  adminSmsSent                     AdminSmsMessage[]                @relation("AdminSmsSender")
  adminSmsReceived                 AdminSmsMessage[]                @relation("AdminSmsRecipient")
  apiAccessTokensUpdated           ApiAccessToken[]                 @relation("ApiAccessTokenUpdatedBy")
  payoutAccounts                   PayoutAccount[]
  kycVerifications                 KycVerification[]
  assistantConversation            AssistantConversation?
  faqsCreated                      Faq[]                            @relation("FaqCreatedBy")

  @@index([promotedById])
  @@index([originCountryId])
  @@map("users")
}

model DykSettings {
  id              String  @id @default("default")
  enabled         Boolean @default(false)
  intervalMinutes Int     @default(60)
  maxDisplays     Int     @default(3)
}

model DykNotice {
  id             String         @id @default(uuid())
  content        String
  imageKey       String
  imageBucket    String
  href           String
  ctaLabel       String         @default("Try it Now") // action-button text; admin-editable, was hardcoded on the frontend before this column existed
  // OR logic: the notice stops for a trainer once ANY one of these
  // conditions is met (DykService.adopted checks each in turn). Replaces the
  // old single stopCondition column -- existing rows were backfilled to a
  // one-element array by the migration that introduced this column.
  stopConditions String[]       @default(["CLICKED"])
  targetId       String?
  active         Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  states         DykUserState[]
}

model DykUserState {
  userId      String
  noticeId    String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice      DykNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  displays    Int       @default(0)
  lastShownAt DateTime?
  clickedAt   DateTime?
  // Set once the trainer actually lands on the notice's destination --
  // for an internal route, once that page loads (DykController.visit);
  // for an external link (which the app can't observe after navigation),
  // this is set at click time instead, same moment as clickedAt. Distinct
  // from clickedAt, which only means "pressed Try it Now."
  visitedAt   DateTime?

  @@id([userId, noticeId])
  @@index([userId, lastShownAt])
}

model AssistantConversation {
  id        String             @id @default(uuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  AssistantMessage[]

  @@map("assistant_conversations")
}

model AssistantMessage {
  id                   String                @id @default(uuid())
  conversationId       String
  conversation         AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role                 String
  content              String
  createdAt            DateTime              @default(now())
  convertedToFaqId     String?               @unique
  convertedToFaq       Faq?                  @relation(fields: [convertedToFaqId], references: [id], onDelete: SetNull)
  githubIssueNumber    Int?
  githubIssueUrl       String?
  githubIssueCreatedAt DateTime?

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

/// Admin-managed public support content. FAQ entries are deliberately stored
/// separately from the assistant transcript: an administrator must review and
/// provide the answer before a user question becomes public guidance.
model Faq {
  id            String            @id @default(uuid())
  question      String            @unique
  answer        String
  visible       Boolean           @default(true)
  sortOrder     Int               @default(0)
  createdById   String?
  createdBy     User?             @relation("FaqCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sourceMessage AssistantMessage?

  @@index([visible, sortOrder])
  @@map("faqs")
}

enum SystemUpdateKind {
  MAINTENANCE
  COURSE
  BLOG
  MESSAGE
}

enum SystemUpdateSourceType {
  MANUAL
  BLOG_POST
  COURSE
}

model SystemUpdate {
  id            String                 @id @default(uuid())
  kind          SystemUpdateKind
  sourceType    SystemUpdateSourceType @default(MANUAL)
  sourceId      String?
  title         String
  message       String
  href          String?
  authorId      String?
  author        User?                  @relation("SystemUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime               @default(now())
  notifications UserNotification[]

  @@unique([sourceType, sourceId])
  @@index([kind, createdAt])
  @@map("system_updates")
}

model UserNotification {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  updateId  String
  update    SystemUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime     @default(now())

  @@unique([userId, updateId])
  @@index([userId, readAt, createdAt])
  @@map("user_notifications")
}

enum AdminSmsStatus {
  SENT
  FAILED
}

/// Append-only record of an administrator's direct transactional SMS. It
/// records provider acceptance, not handset delivery confirmation.
model AdminSmsMessage {
  id            String         @id @default(uuid())
  senderId      String?
  sender        User?          @relation("AdminSmsSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipientId   String?
  recipient     User?          @relation("AdminSmsRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  phoneNumber   String
  body          String
  provider      String?
  status        AdminSmsStatus
  failureReason String?
  createdAt     DateTime       @default(now())

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
  @@map("admin_sms_messages")
}

/// One pending/resolved invite an inviter sent to an email via the explicit
/// "Invite" CTA (distinct from someone just sharing/copying their referral
/// link -- that path never creates a row here, it's covered directly by
/// User.referredById). INVITED rows expire 24h after creation and are
/// lazily deleted on next read (WalletController.getTrainerDashboard) --
/// never surfaced as "expired" in the UI, just removed. If the invited
/// email registers under THIS inviter's code before expiry, the row
/// transitions to JOINED (joinedUserId set) and is kept for history; if the
/// email registers under any OTHER inviter's code (or with no code at all),
/// the row is deleted outright since the invite is no longer relevant.
/// @@unique([inviterId, email]) means a second invite to the same email by
/// the same inviter reactivates (upserts) the existing row rather than
/// creating a duplicate -- this does NOT block different inviters from
/// each having their own pending invite to the same email.
model ReferralInvite {
  id           String               @id @default(uuid())
  inviterId    String
  inviter      User                 @relation("ReferralInvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  email        String
  firstName    String
  status       ReferralInviteStatus @default(INVITED)
  joinedUserId String?
  joinedUser   User?                @relation("ReferralInviteJoined", fields: [joinedUserId], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([inviterId, email])
  @@index([email])
  @@index([inviterId, status, expiresAt]) // covers getPendingReferralInvites's WHERE inviterId + status=INVITED + expiresAt filter (both the lazy-expiry deleteMany and the findMany that follows it)
  @@map("referral_invites")
}

/// Countries used for both a user's country of origin and dialect coverage.
/// A user's selected training dialect must belong to their selected training
/// country -- enforced in AuthService.updateProfile, not at the schema level,
/// since Prisma has no cross-FK check constraint.
model Country {
  id                      String                   @id @default(uuid())
  code                    String                   @unique // ISO 3166-1 alpha-2, e.g. "NG", "US"
  name                    String
  llmGenerationEnabled    Boolean                  @default(false) // opts this country's dialects into word-generator-job's translation sweep; a dialect only participates when both this AND Dialect.llmGenerationEnabled are true
  currencyCode            String                   @default("USD") // ISO 4217, e.g. "NGN", "KES" -- what wallet balances and P2P offers display in for this country's users
  usdExchangeRate         Decimal?                 @db.Decimal(18, 6) // units of currencyCode per 1 USD; null until fx-rate-job's first successful fetch or an admin sets one manually
  exchangeRateSource      String                   @default("LIVE") // "LIVE" (fx-rate-job may overwrite usdExchangeRate) or "MANUAL" (admin-set, fx-rate-job skips this row until reset)
  exchangeRateUpdatedAt   DateTime? // last time usdExchangeRate changed (live fetch or admin edit) -- shown in UI so a stale rate is visible, not silently trusted
  dialects                Dialect[]
  users                   User[]
  originUsers             User[]                   @relation("UserOriginCountry")
  audioRetentionRules     AudioRetentionRule[]
  dataAccessLeadInterests DataAccessLeadInterest[]
  communityProfiles       CommunityProfile[]

  @@map("countries")
}

/// Admin-configured audio-purge rule (see "Dataset & Storage" admin settings
/// tab). Scoping is optional in both dimensions: null countryId/dialectTag
/// means "applies to all countries/dialects". audio-retention-job resolves,
/// per terminal WordRecording row, the MOST SPECIFIC enabled rule
/// matching its dialectTag (and that dialect's country) -- country+dialect
/// beats dialect-only beats country-only beats the fully-unscoped catch-all.
/// No matching enabled rule at all = that row's audio is never purged (safe
/// default, matches pre-feature "keep forever" behavior). This only ever
/// deletes the Spaces audio object and nulls audioBucket/audioKey -- it never
/// deletes the row, transcript, asrWordDetail, or any score.
model AudioRetentionRule {
  id            String   @id @default(uuid())
  enabled       Boolean  @default(true)
  countryId     String?
  country       Country? @relation(fields: [countryId], references: [id], onDelete: Cascade)
  dialectTag    String? // free-text, matches Dialect.tag/WordRecording.dialectTag convention -- not an FK since those already aren't FKs either
  retentionDays Int // days after a row reaches terminal state (settledAt or refundedAt set) before its audio is purged
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([countryId, dialectTag])
  @@map("audio_retention_rules")
}

/// Onboarding dialect choice. `tag` matches the free-text dialectTag values
/// already used by WordRecording (en-us, ig, yo, ha) -- this table is the
/// source of truth for that list going forward, not a parallel/competing enum.
model Dialect {
  id                   String           @id @default(uuid())
  tag                  String           @unique
  name                 String
  countryId            String
  active               Boolean          @default(true) // disabled dialects are hidden from onboarding and revoke current trainer selections
  llmGenerationEnabled Boolean          @default(false) // per-dialect override within an enabled country -- lets admin exclude one dialect without disabling the whole country
  keyboardLayout       String? // space-separated dialect-specific characters/diacritics for the inline virtual keyboard on the word-training spelling input; admin-edited, optionally AI-drafted via POST /geo/admin/dialects/:id/generate-keyboard-layout
  country              Country          @relation(fields: [countryId], references: [id])
  users                User[]
  variants             DialectVariant[]

  @@index([countryId])
  @@map("dialects")
}

/// Optional sub-dialect tag under a Dialect -- e.g. Izzi/Ezza/Ezeagu under
/// Igbo. Shares the parent dialect's entire content pool (prompts, words,
/// keyboard layout, ASR model) -- training/scoring/prompt-selection stay
/// scoped by Dialect.tag exactly as before. A variant exists purely to
/// label which recordings/submissions came from a given sub-dialect
/// speaker, for admin review and future variant-specific model training.
/// tag is unique per dialect, not globally -- two different dialects may
/// each have a variant tagged e.g. "standard", so any code deriving a
/// storage path or cache key from variant tag MUST also include the parent
/// dialect's tag (see WordsService's upload key builder).
model DialectVariant {
  id        String   @id @default(uuid())
  dialectId String
  dialect   Dialect  @relation(fields: [dialectId], references: [id], onDelete: Cascade)
  tag       String
  name      String
  active    Boolean  @default(true) // disabled sub-dialects are hidden from selection and revoke current trainer selections
  createdAt DateTime @default(now())

  users          User[]
  wordRecordings WordRecording[]

  @@unique([dialectId, tag])
  @@index([dialectId])
  @@map("dialect_variants")
}

/// One row per external identity provider linked to a user (Google, email/magic-link).
/// Credentials accounts don't get a row here -- passwordHash on User is enough.
model LinkedAccount {
  id                String       @id @default(uuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerAccountId String // Google sub, or the email address for magic-link
  createdAt         DateTime     @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("linked_accounts")
}

/// Opaque, rotated on every refresh (rotation-on-use) so a stolen refresh
/// token can only be replayed once before detection. Revoked rows are kept
/// (not deleted) so reuse-of-a-revoked-token can be detected and treated as
/// a signal to revoke the whole family. See AGENTS.md "Authentication".
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  familyId   String // shared across a rotation chain; revoking one revokes the family
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String? // tokenHash of the token that replaced this one, if rotated
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  WITHDRAWAL
  DEPOSIT
  ADMIN_PAYOUT
  P2P_PAYMENT_METHOD
  PHONE_VERIFICATION
  P2P_TRADE
  SUB_DISTRIBUTOR_ADJUSTMENT
  PAYOUT_ACCOUNT_DELETE
  PAYOUT_ACCOUNT_SETUP // confirms a self-typed STABLECOIN_WALLET address before it's saved and locked -- BANK/MOBILE_MONEY/STRIPE_CONNECT don't need this (provider-verified or unverified-by-design), but a trainer-typed wallet address is the one payout-account type nothing else confirms
  SUBSCRIBER_EMAIL_VERIFY // Voice Stream subscriber auth -- shares this enum only for MailService.sendOtpEmail's copy lookup; SubscriberOtpCode is its own table (OtpCode's FK to User can't reference SubscriberUser)
  SUBSCRIBER_LOGIN
  ACCOUNT_CLOSE
}

enum ManualPhoneVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

/// One-time email codes gating registration/login (2FA), wallet/admin-payout,
/// and P2P payment-method edits. purpose discriminates all flows in one table -- same
/// shape/mechanics throughout (generate, hash, TTL, attempts, consume-once),
/// matching LedgerEntryType's one-table-plus-enum precedent rather than a
/// table per purpose. ticketHash is used only by REGISTRATION/LOGIN (an
/// opaque pending-auth ticket minted post-password-check, see AuthService);
/// contextHash is used by WITHDRAWAL/DEPOSIT/ADMIN_PAYOUT/P2P_PAYMENT_METHOD (a hash of the
/// canonicalized transaction details, binding a code to the exact
/// amount/destination it was issued for -- see wallet/otp-context.util.ts --
/// so a valid code can't be replayed against a modified transaction).
model OtpCode {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     OtpPurpose
  codeHash    String
  ticketHash  String?    @unique
  contextHash String?
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

model ManualPhoneVerificationRequest {
  id                String                        @id @default(uuid())
  userId            String
  user              User                          @relation("ManualPhoneVerificationUser", fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber       String
  otpHash           String
  status            ManualPhoneVerificationStatus @default(PENDING)
  feeTokenAmount    Decimal                       @default(1) @db.Decimal(20, 8)
  attempts          Int                           @default(0) // wrong-OTP guesses by the reviewing admin; mirrors OtpCode's attempts/maxAttempts lockout pattern
  maxAttempts       Int                           @default(5)
  sentAt            DateTime?
  verifiedByAdminId String?
  verifiedByAdmin   User?                         @relation("ManualPhoneVerificationAdmin", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)
  verifiedAt        DateTime?
  rejectedAt        DateTime?
  expiresAt         DateTime
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@index([status, createdAt])
  @@index([userId, status])
  @@index([phoneNumber, status])
  @@index([verifiedByAdminId])
  @@map("manual_phone_verification_requests")
}

/// Mirrors Didit's own status vocabulary directly so the webhook handler
/// never needs a translation layer between their value and ours.
enum KycStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  DECLINED
  ABANDONED
  EXPIRED
}

/// One row per verification attempt (a trainer can retry after DECLINED/
/// EXPIRED) -- full history kept for compliance review, unlike User.kycStatus
/// below which is a denormalized read-cache of the latest resolved attempt so
/// withdrawal gating doesn't need a join on every request.
model KycVerification {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String    @default("didit")
  providerSessionId     String    @unique
  status                KycStatus @default(NOT_STARTED)
  documentType          String?
  documentNumberMasked  String?
  faceMatchScore        Decimal?  @db.Decimal(5, 2)
  livenessScore         Decimal?  @db.Decimal(5, 2)
  // Full Didit decision payload (document number, name, DOB, etc.) --
  // AES-256-GCM encrypted via kyc-crypto.util.ts, never stored plaintext.
  // The columns above are the masked/display subset admins actually need.
  decisionEncryptedJson Json?
  declineReason         String?
  webhookReceivedAt     DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("kyc_verifications")
}

enum SubmissionStatus {
  PENDING // ASR not yet completed
  TRANSCRIBED // ASR ok, awaiting quorum/scoring
  REJECTED // ASR prefilter/unreadable/unsupported-dialect rejection
  SCORED // consensus-scorer wrote a score
  SETTLED // settlement-job paid it out
  EXPIRED // settlement-job's scoring SLA elapsed with no quorum reached; tokens refunded, terminal state
}

/// Multi-word English sentence content -- replaces Prompt for every
/// trainer-facing purpose (dictation and SENTENCE_REBUILD/PHRASE_TO_DIALECT
/// are retired; see WordsService.nextAssignment). Mirrors Word's shape
/// (unique text, translations, recordings) but for sentences. wordCount is
/// stamped once at insert time by word-generator-job so WordsService's
/// tier-gated Word-vs-Sentence pool selection (pickSentenceSource,
/// phrase-tiers.const.ts) can filter on it directly without re-splitting
/// text at pick time.
model Sentence {
  id         String   @id @default(uuid())
  text       String   @unique
  wordCount  Int
  createdAt  DateTime @default(now())
  isDisabled Boolean  @default(false) // admin-toggled: excluded from pickSentenceSource so it's never served to a new trainer again, but existing recordings/assignments/FKs are untouched -- the non-destructive alternative to deleting a sentence that already has settled history

  recordings          WordRecording[]
  trainingAssignments WordTrainingAssignment[]
  translations        SentenceTranslation[]

  @@index([wordCount])
  @@index([isDisabled])
  @@map("sentences")
}

/// LLM-generated dialect translation of a Sentence's English text, produced
/// by word-generator-job for admin curation/reference -- mirrors
/// WordTranslation exactly. Dialect only enters the actual training flow at
/// recording time (WordRecording.dialectTag), same posture as
/// WordTranslation; unlike the old PromptTranslation, no second per-dialect
/// Sentence row is ever inserted, since nothing reads Sentence by dialectTag.
model SentenceTranslation {
  id         String   @id @default(uuid())
  sentenceId String
  sentence   Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  dialectTag String
  text       String
  createdAt  DateTime @default(now())

  @@unique([sentenceId, dialectTag])
  @@index([dialectTag])
  @@map("sentence_translations")
}

/// A single English word from the fixed seed word bank (services/api/prisma/seed.ts).
/// Not user-editable -- adding a word means adding it to the seed list and
/// re-running the seed, same as any other reference data in this repo.
model Word {
  id           String        @id @default(uuid())
  text         String        @unique
  partOfSpeech PartOfSpeech? // English part of speech; null until LLM-classified (word-generator-job) or backfilled
  createdAt    DateTime      @default(now())
  isDisabled   Boolean       @default(false) // admin-toggled: excluded from pickEnglishToDialectWord so it's never served to a new trainer again, but existing recordings/assignments/FKs are untouched -- the non-destructive alternative to deleting a word that already has settled history

  recordings          WordRecording[]
  trainingAssignments WordTrainingAssignment[]
  translations        WordTranslation[]
  skips               WordSkip[]

  @@index([isDisabled])
  @@map("words")
}

/// Tracks how many times a trainer has abandoned (skipped, without recording)
/// an ENGLISH_TO_DIALECT assignment for this word -- see WordsService.
/// nextAssignment. Once skipCount reaches the configured threshold (default
/// 2, see PlatformSettingsService.getWordSkipBanThreshold), the word is
/// excluded from that trainer's future assignment picks for good; there's no
/// reset/expiry, since a word they've twice chosen not to attempt isn't
/// coming back into rotation on its own.
model WordSkip {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId    String
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  skipCount Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, wordId])
  @@map("word_skips")
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  INTERJECTION
  DETERMINER
  OTHER
}

/// LLM-generated dialect translation of a Word's English text, produced by
/// word-generator-job for admin curation/reference. Dialect only enters the
/// actual training flow at recording time (WordRecording.dialectTag), so
/// this table doesn't need a second trainer-facing insert the way
/// PromptTranslation does.
model WordTranslation {
  id           String        @id @default(uuid())
  wordId       String
  word         Word          @relation(fields: [wordId], references: [id], onDelete: Cascade)
  dialectTag   String
  text         String
  partOfSpeech PartOfSpeech? // dialect-specific part of speech for this translation -- can differ from the English Word's (e.g. a translation that's a different grammatical category)
  createdAt    DateTime      @default(now())

  @@unique([wordId, dialectTag])
  @@index([dialectTag])
  @@map("word_translations")
}

enum WordTrainingDirection {
  ENGLISH_TO_DIALECT
  DIALECT_TO_ENGLISH
}

enum RecordingNoiseRating {
  NOISY
  FAIR
  QUIET
}

/// Speech-expression metadata (Phase 1 of docs/Dialect-Library-Speech-Expression-Metadata-Plan.md)
/// -- quality-gate-worker's optional emotion/prosody analysis pass, gated by
/// PlatformSettings.speechExpressionEnabled. Purely descriptive: never feeds
/// compositeScore or payout (see that field's doc comment on WordRecording).
enum SpeechEmotion {
  NEUTRAL
  HAPPY
  SAD
  ANGRY
  FEARFUL
  SURPRISED
  DISGUSTED
}

enum SpeechTone {
  FORMAL
  CASUAL
  EMPHATIC
  FLAT
}

enum SpeechStyle {
  CONVERSATIONAL
  READ_ALOUD
  EXPRESSIVE
}

enum SpeechSpeed {
  SLOW
  NORMAL
  FAST
}

enum SpeechEnergy {
  LOW
  MEDIUM
  HIGH
}

/// Admin manual audit outcome for a WordRecording -- distinct from
/// rejectionReason (machine-set ASR prefilter). Null means not yet
/// reviewed. Set via WalletController's admin recording-audit routes, which
/// call adjustAdminWallet for a payout clawback when an admin marks an
/// already-paid-out recording INVALID and opts into reclaiming it.
enum AdminAuditStatus {
  VALID
  INVALID
}

model TrainingSession {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion String
  consentedAt  DateTime
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  lastQracAt   DateTime? // last time this session's trainer signed the QRAC checklist; nextAssignment compares elapsed time against this (falling back to startedAt when never signed) to decide whether a re-affirmation is due -- see PlatformSettings.qracEnabled/qracIntervalMinutes

  assignments      WordTrainingAssignment[]
  recordings       WordRecording[]
  qracAffirmations QracAffirmationSubmission[]

  @@index([userId, startedAt])
  @@map("training_sessions")
}

/// Append-only, immutable log of QRAC ("Quality Recordings Affirmation
/// Check") signings -- a trainer periodically re-confirms a fixed checklist
/// of recording-quality rules mid-session (see WordsService.nextAssignment).
/// version is a per-USER sequential "major.minor" counter (1.0, 1.1, ...,
/// 1.9, 2.0, ...), not tied to checklist content -- computed from the
/// user's own previous QracAffirmationSubmission, same append-only/
/// never-updated convention as ValuationSnapshot.
model QracAffirmationSubmission {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId        String?
  session          TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  version          String // per-user sequential major.minor counter, see nextQracVersion in qrac.util.ts
  checklistVersion String           @default("v1") // identifies which QRAC_CHECKLIST wording (qrac.util.ts) this signing agreed to
  signedAt         DateTime         @default(now())

  @@index([userId, signedAt])
  @@map("qrac_affirmation_submissions")
}

enum TestimonyKind {
  VIDEO
  TEXT
}

enum TestimonyStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A trainer's paid testimony -- VIDEO (max PlatformSettings.
/// testimonyMaxVideoSeconds, uploaded publicly via StorageService's
/// publicRead flag so the homepage carousel can embed it directly) or TEXT
/// (max PlatformSettings.testimonyMaxTextLength chars). Mutable (unlike the
/// append-only QracAffirmationSubmission above) since admin review flips
/// status PENDING -> APPROVED/REJECTED; approval credits a one-time DL
/// reward via creditTestimonyReward, keyed by this row's id as the
/// LedgerEntry reference for idempotency.
model Testimony {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind              TestimonyKind
  text              String? // TEXT testimonies only
  videoBucket       String? // VIDEO testimonies only
  videoKey          String? // VIDEO testimonies only
  durationMs        Int? // VIDEO testimonies only, actual recorded length
  status            TestimonyStatus @default(PENDING)
  reviewedAt        DateTime?
  reviewedByAdminId String?
  adminEditedAt     DateTime? // editorial correction to a pending TEXT testimony, before review
  editedByAdminId   String?
  editedByAdmin     User?           @relation("TestimonyEditedBy", fields: [editedByAdminId], references: [id], onDelete: SetNull)
  rejectionReason   String?
  rewardCredited    Boolean         @default(false) // set true once creditTestimonyReward actually credits -- lets the admin UI show "rewarded" without re-deriving it from the ledger
  visible           Boolean         @default(true) // admin can hide an already-approved testimony from the public homepage without reversing its approval or reward
  createdAt         DateTime        @default(now())

  @@index([userId])
  @@index([editedByAdminId])
  @@index([status, createdAt])
  @@map("testimonies")
}

enum MarketingAdFormat {
  FEED_SQUARE // 1080x1080
  STORY // 1080x1920
  LINK_PREVIEW // 1200x630
}

/// Admin-uploaded photo for a trainer share campaign, scoped to one ad
/// format/size. Uploaded via presigned URL with publicRead: true (same
/// pattern as Testimony's video upload), since the chosen photo becomes the
/// OpenGraph image on a trainer's public /invite/[code]/[shareId] link.
model MarketingAdPhoto {
  id        String                   @id @default(uuid())
  format    MarketingAdFormat
  bucket    String
  key       String
  active    Boolean                  @default(true)
  sortOrder Int                      @default(0)
  createdAt DateTime                 @default(now())
  shares    MarketingCampaignShare[]

  @@index([format, active, sortOrder])
  @@map("marketing_ad_photos")
}

/// Admin-written title/description for a trainer share campaign, scoped to
/// the same ad format as the photo it will be paired with.
model MarketingHeadline {
  id          String                   @id @default(uuid())
  format      MarketingAdFormat
  title       String
  description String
  active      Boolean                  @default(true)
  sortOrder   Int                      @default(0)
  createdAt   DateTime                 @default(now())
  shares      MarketingCampaignShare[]

  @@index([format, active, sortOrder])
  @@map("marketing_headlines")
}

/// One row per trainer's chosen (photo, headline) pairing, created lazily
/// the first time the trainer confirms that pairing in the share dialog.
/// The unique constraint below makes that creation idempotent -- resharing
/// the same pairing reuses the same id/stats instead of fragmenting counts.
/// This row's id is the "campaign" path segment in
/// /invite/[code]/[shareId].
model MarketingCampaignShare {
  id            String                          @id @default(uuid())
  userId        String
  user          User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoId       String
  photo         MarketingAdPhoto                @relation(fields: [photoId], references: [id], onDelete: Cascade)
  headlineId    String
  headline      MarketingHeadline               @relation(fields: [headlineId], references: [id], onDelete: Cascade)
  viewCount     Int                             @default(0)
  createdAt     DateTime                        @default(now())
  registrations MarketingCampaignRegistration[]

  @@unique([userId, photoId, headlineId])
  @@index([userId])
  @@map("marketing_campaign_shares")
}

/// One row per invitee who registered having arrived through a specific
/// campaign share -- a separate table (not just a counter on the share) so
/// each invitee is individually attributable, mirroring how ReferralInvite
/// tracks individual invitee status rather than only incrementing a count.
model MarketingCampaignRegistration {
  id            String                 @id @default(uuid())
  shareId       String
  share         MarketingCampaignShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  invitedUserId String                 @unique
  invitedUser   User                   @relation(fields: [invitedUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime               @default(now())

  @@index([shareId])
  @@map("marketing_campaign_registrations")
}

/// A server-issued prompt prevents the client from choosing a source word,
/// direction, or reverse-validation target after the session has started.
model WordTrainingAssignment {
  id                String                @id @default(uuid())
  sessionId         String
  session           TrainingSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  wordId            String? // required for a Word-sourced ENGLISH_TO_DIALECT/DIALECT_TO_ENGLISH assignment; null when sentenceId is set instead
  word              Word?                 @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sentenceId        String? // required for a Sentence-sourced ENGLISH_TO_DIALECT/DIALECT_TO_ENGLISH assignment; null when wordId is set instead
  sentence          Sentence?             @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  direction         WordTrainingDirection
  sourceRecordingId String?
  uploadBucket      String?
  uploadKey         String?
  createdAt         DateTime              @default(now())
  consumedAt        DateTime?
  recording         WordRecording?

  @@index([sessionId, createdAt])
  @@index([sourceRecordingId])
  @@index([sentenceId])
  @@map("word_training_assignments")
}

/// Historical rows may have no user/session/assignment. All new dashboard
/// submissions are authenticated and linked to a consented training session.
///
/// Scoring/payout has its own path, since word training has no
/// consensus/quorum concept:
///   - DIALECT_TO_ENGLISH: self-scores at creation (exact-match against the
///     known English word/sentence text) -- WordsService.createRecording sets
///     validationScore/score/status=SCORED synchronously. Its source is an
///     existing ENGLISH_TO_DIALECT recording (see WordsService.
///     pickReverseSource). The trainer's own fresh dialect audio recorded in
///     this same step is ALSO inserted as a second, new WordRecording row
///     (direction ENGLISH_TO_DIALECT, status PENDING, redoOfRecordingId
///     pointing back at the source) -- this is what keeps the dialect pool
///     growing recording-by-recording: each DIALECT_TO_ENGLISH attempt both
///     validates the recording before it and produces a fresh one to be
///     validated later.
///   - ENGLISH_TO_DIALECT: has no ground truth of its own. Scored only once
///     a peer's reverse-validation (a DIALECT_TO_ENGLISH recording whose
///     sourceRecordingId points back at it) lands -- see WordsService.
///     scoreReverseValidatedSource. Until then it stays PENDING and is
///     excluded from settlement.
model WordRecording {
  id                        String                  @id @default(uuid())
  wordId                    String? // null when sentenceId is set instead
  word                      Word?                   @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sentenceId                String? // null when wordId is set instead
  sentence                  Sentence?               @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  userId                    String?
  user                      User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId                 String?
  session                   TrainingSession?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  assignmentId              String?                 @unique
  assignment                WordTrainingAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  direction                 WordTrainingDirection   @default(ENGLISH_TO_DIALECT)
  dialectTag                String
  dialectVariantId          String? // optional sub-dialect label (see DialectVariant) -- never changes prompt selection or scoring, purely descriptive
  dialectVariant            DialectVariant?         @relation(fields: [dialectVariantId], references: [id])
  translationText           String
  normalizedTranslationText String? // AI spelling-normalization of translationText (PlatformSettings.spellingNormalizationEnabled), ENGLISH_TO_DIALECT only -- informational only, never feeds validationScore/score
  audioBucket               String? // null after audio-retention-job purges it
  audioKey                  String? // null after audio-retention-job purges it
  audioDeletedAt            DateTime? // set by audio-retention-job when it purges the Spaces object per an AudioRetentionRule; audioBucket/audioKey are nulled at the same time. translationText/scores are never touched.
  redoOfRecordingId         String? // set only on the new ENGLISH_TO_DIALECT row inserted as the "redo" side-effect of a DIALECT_TO_ENGLISH attempt -- points at the peer WordRecording this attempt both reverse-validated and re-recorded. Purely descriptive/audit trail; never read by scoring logic.
  durationMs                Int?
  noiseRating               RecordingNoiseRating?
  validationScore           Decimal?                @db.Decimal(5, 4) // 0-1 exact-match score, DIALECT_TO_ENGLISH only
  status                    SubmissionStatus        @default(PENDING) // PENDING|SCORED|SETTLED|REJECTED|EXPIRED. REJECTED is quality-gate-worker's prefilter hard-reject (duration_out_of_range|mostly_silence|unreadable_audio, see rejectionReason); EXPIRED is settlement-job's terminal state once scoringSlaMinutes/wordStuckTimeoutMinutes elapses with no reverse-validation (see refundStuckWordRecordings/resolveTimedOutScoring) -- still no consensus/quorum concept otherwise; TRANSCRIBED remains unused here.
  rejectionReason           String? // set only when status=REJECTED (duration_out_of_range | mostly_silence | unreadable_audio)
  tokensSpent               Decimal                 @default(0) @db.Decimal(20, 8) // task cost locked from the trainer's wallet at submit time (see Wallet.lockedBalance)
  rawScore                  Decimal?                @db.Decimal(5, 2) // 0.00-100.00 original exact-match/reverse-validation score before any admin score-range weighting/clamp; used for partner data queries
  score                     Decimal?                @db.Decimal(5, 2) // 0.00-100.00 platform score; null until SCORED
  transcript                String? // ASR transcript of the spoken audio; null until vosk-worker/whisper-worker's ASR pass completes, may remain null forever for an unsupported dialect
  asrEngine                 String? // "vosk" | "whisper", whichever transcribed this row -- see models/asr-registry.yaml
  asrConfidence             Decimal?                @db.Decimal(5, 4) // mean per-word confidence, 0-1; null when the engine has none (Whisper)
  asrWordDetail             Json? // [{word, start, end, conf}], seconds; conf null for Whisper-origin rows
  asrMatchScore             Decimal?                @db.Decimal(5, 2) // 0-100, how closely the ASR transcript matches translationText (normalized comparison, computed by the worker at ASR-write time) -- feeds computeWordRecordingCompositeScore via PlatformSettings.qualityWeightAsrMatch (default 0, opt-in); never affects validationScore/score/status directly
  noiseScore                Decimal?                @db.Decimal(5, 2) // 0-100, quality-gate-worker's SNR-derived estimate; null until the gate has run
  qualityScore              Decimal?                @db.Decimal(5, 2) // 0-100, quality-gate-worker's clipping/artifact composite; null until the gate has run
  livenessScore             Decimal?                @db.Decimal(5, 2) // 0-100, quality-gate-worker's live-human-voice classifier confidence; null until the gate has run
  emotion                   SpeechEmotion? // speech-expression analysis's top predicted emotion class; null until computed, purely descriptive -- never affects compositeScore/payout (see PlatformSettings.speechExpressionEnabled doc comment)
  emotionConfidence         Decimal?                @db.Decimal(5, 4) // 0-1 confidence of `emotion`'s predicted class (softmax max), same scale convention as asrConfidence
  tone                      SpeechTone? // descriptive only, same posture as `emotion`
  style                     SpeechStyle? // descriptive only, same posture as `emotion`
  speed                     SpeechSpeed? // descriptive bucket derived from prosodyMetrics.speechRateEstimate; descriptive only
  energy                    SpeechEnergy? // descriptive bucket derived from prosodyMetrics.meanRmsDb; descriptive only
  prosodyMetrics            Json? // {speechRateEstimate, meanPitchHz, pitchStdHz, meanRmsDb, rmsStdDb, pauseRatio}, all null-safe floats; numeric companion to the bucketed fields above, same "measured but never scored" posture as asrWordDetail's Json-blob convention
  expressionCheckedAt       DateTime? // when speech-expression analysis last wrote the fields above; null until it has run (or the feature is off) -- distinct from qualityGateCheckedAt since the two may diverge later even though the same worker currently writes both
  compositeScore            Decimal?                @db.Decimal(5, 2) // weighted blend of score+noiseScore+qualityScore+livenessScore+asrMatchScore (PlatformSettings.qualityWeight*, computeWordRecordingCompositeScore), clamped into [minScoreRange, maxScoreRange] -- this, not score, feeds computeTrainingPayout once qualityGateEnabled. Emotion/prosody fields above are deliberately excluded from this blend.
  qualityGateCheckedAt      DateTime? // when quality-gate-worker last wrote noise/quality/livenessScore
  payoutTokenAmount         Decimal?                @db.Decimal(20, 8) // computed at settlement, null until SETTLED
  scoredAt                  DateTime?
  settledAt                 DateTime?
  refundedAt                DateTime? // set once settlement-job releases a stuck-timeout ENGLISH_TO_DIALECT recording's lock back to balance
  adminAuditStatus          AdminAuditStatus? // null = not yet reviewed; see AdminAuditStatus doc comment
  adminAuditedAt            DateTime?
  createdAt                 DateTime                @default(now())

  @@index([wordId])
  @@index([sentenceId])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([dialectTag])
  @@index([status])
  @@index([rawScore])
  @@map("word_recordings")
}

/// Phase 1 of the Validator Dashboard (docs/validators.md): a validator-owned
/// curated collection of WordRecordings, distinct from the subscriber-owned
/// StreamDeck (voice-stream/stream-decks) -- kept as a fully separate model
/// so the internal QA pipeline never depends on the B2B product's schema.
/// This phase is DRAFT-only: no submit/approve/publish state machine yet
/// (see ValidatorDeckStatus doc comment).
enum ValidatorDeckStatus {
  DRAFT // being built by its creator -- the only status Phase 1 writes
  PENDING_L2 // reserved for Phase 2's approval chain
  PENDING_L3
  PENDING_ADMIN
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
}

model ValidatorDeck {
  id                String              @id @default(uuid())
  name              String
  createdByUserId   String // provenance, never changes
  createdBy         User                @relation("ValidatorDeckCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  // Current editor -- admin-reassignable in a later phase; equals
  // createdByUserId until reassignment exists.
  ownerUserId       String
  owner             User                @relation("ValidatorDeckOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  status            ValidatorDeckStatus @default(DRAFT)
  dialectTag        String? // descriptive only, mirrors StreamDeck's scoping metadata loosely
  countryCode       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  items ValidatorDeckItem[]

  @@index([ownerUserId])
  @@index([createdByUserId])
  @@index([status])
  @@map("validator_decks")
}

enum ValidatorItemStatus {
  UNSCORED
  VALID
  INVALID
  REJECTED
}

model ValidatorDeckItem {
  id            String              @id @default(uuid())
  deckId        String
  deck          ValidatorDeck       @relation(fields: [deckId], references: [id], onDelete: Cascade)
  // WordRecording.id, deliberately no FK -- same loose-coupling as
  // StreamDeckItem.recordingId, since recordings are purgeable by
  // audio-retention-job independent of deck membership.
  recordingId   String
  addedByUserId String
  addedAt       DateTime            @default(now())

  validationStatus ValidatorItemStatus @default(UNSCORED)
  validatorScore   Decimal?            @db.Decimal(5, 2)
  validatorNotes   String?
  scoredAt         DateTime?

  @@unique([deckId, recordingId])
  @@index([deckId])
  @@index([recordingId])
  @@map("validator_deck_items")
}

/// A trainer may earn one training payout for a given source item. The
/// sourceKey is `word:<id>` or `sentence:<id>` so the uniqueness rule works
/// across the nullable WordRecording foreign keys. A trainer can contribute
/// another take for data quality, but only their first settled take of that
/// source may create a monetary reward.
model TrainingPayoutClaim {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceKey   String
  recordingId String   @unique
  createdAt   DateTime @default(now())

  @@unique([userId, sourceKey])
  @@index([userId])
  @@map("training_payout_claims")
}

enum LedgerEntryType {
  DEPOSIT
  TRAINING_PAYOUT
  TASK_SPEND // legacy: pre-lock-model immediate debit, no longer written by submit flows; kept for historical rows
  TASK_LOCK // submit time: balance -> lockedBalance, always negative (see Wallet.lockedBalance)
  TASK_REFUND // reject/stuck-timeout: lockedBalance -> balance, always positive, no net loss
  WITHDRAWAL
  WITHDRAWAL_REVERSED
  REFERRAL_COMMISSION // legacy: old single-rate funding commission entries
  REFERRAL_FUNDING_BONUS
  REFERRAL_PAYOUT_BONUS
  DISTRIBUTOR_BULK_ALLOCATION
  DISTRIBUTOR_FUNDING_BONUS
  DISTRIBUTOR_PAYOUT_BONUS
  SUB_DISTRIBUTOR_ADJUSTMENT // signed: a parent distributor's manual credit (positive) or debit (negative) against their own sub-distributor's wallet, OTP-gated -- see DistributorsService.adjustSubDistributorWallet
  ADMIN_FUNDING
  ADMIN_ADJUSTMENT // signed: admin correction against any user's wallet; negative values are silent debit corrections
  STARTUP_BONUS
  COURSE_COMPLETION_REWARD // one-time per (wallet, courseId reference); see Course.completionRewardTokens
  TESTIMONY_APPROVED_REWARD // one-time per (wallet, testimonyId reference); credited on admin approval, see creditTestimonyReward
  PHONE_VERIFICATION_FEE
  PHONE_VERIFICATION_FEE_REFUND // reverses PHONE_VERIFICATION_FEE when a manual verification request is rejected or expires unused -- see AuthService.refundManualPhoneVerificationFee
  P2P_ESCROW_LOCK
  P2P_ESCROW_REFUND
  P2P_ESCROW_RELEASE
  P2P_ESCROW_CREDIT
}

/// The reserve engine is deliberately separate from the legacy Wallet and
/// LedgerEntry models. Wallet remains the compatibility balance while token
/// mutations are progressively moved to TokenAccount/TokenLedgerEntry.
enum TokenAccountKind {
  USER
  TREASURY
  BURN
}

enum TokenOperationType {
  MINT
  TRANSFER
  LOCK
  UNLOCK
  BURN
  REDEEM
  ADJUSTMENT
  TREASURY_ALLOCATION
}

enum TokenOperationStatus {
  PENDING
  SETTLED
  REVERSED
  CANCELLED
}

enum ReserveTransactionType {
  INITIAL_RESERVE
  PAYMENT_FUNDING
  BUSINESS_REVENUE
  RESERVE_ALLOCATION
  REDEMPTION
  FEE
  REFUND
  REVERSAL
  ADJUSTMENT
  OTHER
}

enum ReserveTransactionStatus {
  PENDING
  ELIGIBLE
  EXCLUDED
  REVERSED
}

enum ReserveDirection {
  CREDIT
  DEBIT
}

model TokenomicsPolicy {
  id                          String   @id @default("default")
  baseCurrency                String   @default("USD")
  enabled                     Boolean  @default(true)
  mintingPaused               Boolean  @default(false)
  valuationIntervalMinutes    Int      @default(1440)
  maxIncreaseRate             Decimal  @default(0.05) @db.Decimal(8, 6)
  maxDecreaseRate             Decimal  @default(0.05) @db.Decimal(8, 6)
  dailyEmissionBudgetUsd      Decimal  @default(0) @db.Decimal(20, 8)
  healthyCoverageThreshold    Decimal  @default(1) @db.Decimal(8, 6)
  watchCoverageThreshold      Decimal  @default(0.8) @db.Decimal(8, 6)
  restrictedCoverageThreshold Decimal  @default(0.6) @db.Decimal(8, 6)
  /// When set, this value replaces the calculated DL/USD rate everywhere
  /// publishedValueUsd is read (getStatus, getCurrentPublishedValue,
  /// recalculateValuation) -- admin override that bypasses the reserve/
  /// supply-derived value entirely. Null means unpinned (use the calculated
  /// value). rawValueUsd on each ValuationSnapshot still records what the
  /// real calculated value would have been while pinned, so drift stays
  /// visible once unpinned.
  pinnedValueUsd              Decimal? @db.Decimal(20, 8)
  updatedAt                   DateTime @updatedAt
  createdAt                   DateTime @default(now())

  @@map("tokenomics_policies")
}

model TokenAccount {
  id        String           @id @default(uuid())
  /// Stable internal key: treasury, burn, or user:<User.id>.
  code      String           @unique
  kind      TokenAccountKind
  userId    String?          @unique
  available Decimal          @default(0) @db.Decimal(20, 8)
  locked    Decimal          @default(0) @db.Decimal(20, 8)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  entries TokenLedgerEntry[]

  @@index([kind])
  @@map("token_accounts")
}

model TokenOperation {
  id             String               @id @default(uuid())
  type           TokenOperationType
  status         TokenOperationStatus @default(SETTLED)
  idempotencyKey String               @unique
  reference      String?
  reason         String?
  policyVersion  String?
  metadata       Json?
  createdAt      DateTime             @default(now())
  settledAt      DateTime?

  entries TokenLedgerEntry[]

  @@index([type, createdAt])
  @@map("token_operations")
}

model TokenLedgerEntry {
  id             String         @id @default(uuid())
  accountId      String
  account        TokenAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  operationId    String
  operation      TokenOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  availableDelta Decimal        @default(0) @db.Decimal(20, 8)
  lockedDelta    Decimal        @default(0) @db.Decimal(20, 8)
  createdAt      DateTime       @default(now())

  @@unique([accountId, operationId])
  @@index([operationId])
  @@map("token_ledger_entries")
}

model ReserveAccount {
  id        String   @id @default(uuid())
  provider  String
  asset     String
  network   String   @default("")
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions ReserveTransaction[]

  @@unique([provider, asset, network])
  @@map("reserve_accounts")
}

model ReserveTransaction {
  id                String                   @id @default(uuid())
  reserveAccountId  String
  reserveAccount    ReserveAccount           @relation(fields: [reserveAccountId], references: [id], onDelete: Restrict)
  type              ReserveTransactionType
  status            ReserveTransactionStatus @default(PENDING)
  direction         ReserveDirection
  /// Original provider amount; the asset is defined by ReserveAccount.
  amount            Decimal                  @db.Decimal(20, 8)
  /// Signed eligibility is derived from direction; this is always a
  /// positive USD-normalized amount before that sign is applied.
  eligibleUsdAmount Decimal                  @db.Decimal(20, 8)
  normalizationRate Decimal                  @db.Decimal(20, 8)
  providerReference String?
  sourceReference   String?
  idempotencyKey    String                   @unique
  reason            String?
  metadata          Json?
  createdAt         DateTime                 @default(now())
  settledAt         DateTime?

  @@index([status, createdAt])
  @@index([providerReference])
  @@index([sourceReference])
  @@map("reserve_transactions")
}

/// One row per (provider, currency), upserted on every successful
/// reserve-balance-poll.ts run -- a live cache, not a history table
/// (ValuationSnapshot already gives historical rate tracking). A failed
/// provider fetch simply leaves the existing row untouched, so fetchedAt
/// naturally reflects staleness; TokenomicsService.getStatus sums whatever
/// is currently here (fresh or stale) as the reserve total, which is the
/// fallback-to-last-known-good behavior by construction.
model ReserveBalanceSnapshot {
  id         String   @id @default(uuid())
  provider   String // 'flutterwave' | 'nowpayments'
  currency   String // provider's own currency code, e.g. 'NGN', 'USDT'
  balanceRaw Decimal  @db.Decimal(20, 8) // provider-currency amount, as reported
  balanceUsd Decimal  @db.Decimal(20, 8) // converted via Country.usdExchangeRate (fiat) or 1:1 (stablecoin/USD)
  fetchedAt  DateTime @default(now())

  @@unique([provider, currency])
  @@map("reserve_balance_snapshots")
}

model ValuationSnapshot {
  id                     String   @id @default(uuid())
  eligibleReserveUsd     Decimal  @db.Decimal(20, 8)
  redeemableSupply       Decimal  @db.Decimal(20, 8)
  totalMinted            Decimal  @db.Decimal(20, 8)
  circulatingSupply      Decimal  @db.Decimal(20, 8)
  treasurySupply         Decimal  @db.Decimal(20, 8)
  lockedSupply           Decimal  @db.Decimal(20, 8)
  burnedSupply           Decimal  @db.Decimal(20, 8)
  rawValueUsd            Decimal  @db.Decimal(20, 8)
  previousPublishedValue Decimal? @db.Decimal(20, 8)
  publishedValueUsd      Decimal  @db.Decimal(20, 8)
  coverageRatio          Decimal? @db.Decimal(20, 8)
  policyVersion          String
  createdAt              DateTime @default(now())

  @@index([createdAt])
  @@map("valuation_snapshots")
}

model DistributorSettings {
  id                        String   @id @default("default")
  enabled                   Boolean  @default(false)
  bulkAllocationEnabled     Boolean  @default(false)
  defaultBulkDiscountRate   Decimal  @default(0) @db.Decimal(8, 6)
  multiLevelReferralEnabled Boolean  @default(false)
  maxReferralDepth          Int      @default(1)
  level1Rate                Decimal  @default(0.05) @db.Decimal(8, 6)
  level2Rate                Decimal  @default(0.02) @db.Decimal(8, 6)
  level3Rate                Decimal  @default(0.01) @db.Decimal(8, 6)
  level4Rate                Decimal  @default(0.002) @db.Decimal(8, 6)
  level5Rate                Decimal  @default(0.0003) @db.Decimal(8, 6)
  updatedAt                 DateTime @updatedAt
  createdAt                 DateTime @default(now())

  @@map("distributor_settings")
}

model DistributorAllocation {
  id            String   @id @default(uuid())
  distributorId String
  distributor   User     @relation("DistributorAllocations", fields: [distributorId], references: [id], onDelete: Cascade)
  grantedById   String
  grantedBy     User     @relation("DistributorAllocationsGranted", fields: [grantedById], references: [id], onDelete: Restrict)
  tokenAmount   Decimal  @db.Decimal(20, 8)
  discountRate  Decimal  @default(0) @db.Decimal(8, 6)
  note          String?
  createdAt     DateTime @default(now())

  @@index([distributorId, createdAt])
  @@index([grantedById, createdAt])
  @@map("distributor_allocations")
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  REJECTED
}

/// One row per user, holds the current token balance. Balance is
/// denormalized (sum of LedgerEntry.amount) for fast reads, but every
/// change MUST go through a LedgerEntry in the same transaction -- the
/// ledger is the source of truth, balance is a cache of it. See
/// AGENTS.md "Wallet / token pool" and docs/Dialectiva_Business_Plan.md §5
/// (Utility Token Pool, distinct from the enterprise-funded Reward Pool).
model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance       Decimal  @default(0) @db.Decimal(20, 8) // spendable
  lockedBalance Decimal  @default(0) @db.Decimal(20, 8) // held pending a submission/recording's outcome -- see TASK_LOCK/TASK_REFUND
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entries     LedgerEntry[]
  deposits    Deposit[]
  withdrawals WithdrawalRequest[]

  @@map("wallets")
}

/// Append-only audit trail. Every balance-changing event -- a completed
/// deposit, a withdrawal debit, a withdrawal reversal -- gets exactly one
/// row here. Never update or delete a row; corrections are new rows.
model LedgerEntry {
  id        String          @id @default(uuid())
  walletId  String
  wallet    Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type      LedgerEntryType
  amount    Decimal         @db.Decimal(20, 8) // positive=credit, negative=debit, tokens
  reference String // Deposit.id or WithdrawalRequest.id this entry backs
  createdAt DateTime        @default(now())

  @@unique([walletId, type, reference])
  @@index([walletId])
  @@map("ledger_entries")
}

/// One row per NOWPayments invoice. Created `pending` when checkout is
/// issued, and credited only after a signature-verified `finished` IPN.
model Deposit {
  id                String    @id @default(uuid())
  walletId          String
  wallet            Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  provider          String    @default("nowpayments")
  providerChargeId  String    @unique
  providerPaymentId String?
  providerStatus    String?
  currency          String // USDC | USDT
  usdAmount         Decimal   @db.Decimal(20, 8)
  tokenAmount       Decimal   @db.Decimal(20, 8)
  actuallyPaid      Decimal?  @db.Decimal(20, 8)
  payCurrency       String?
  status            String    @default("pending") // pending | partially_paid | confirmed | expired | failed | refunded
  createdAt         DateTime  @default(now())
  confirmedAt       DateTime?
  lastIpnAt         DateTime?

  ipnEvents      NowPaymentsIpnEvent[]
  webhookEvents  FlutterwaveWebhookEvent[]
  v4ChargeEvents FlutterwaveV4ChargeEvent[]

  @@index([walletId])
  @@map("deposits")
}

/// Every distinct, signature-verified NOWPayments IPN payload. Keeping the
/// complete notification history makes non-final status changes observable
/// and lets support reconcile a payment without relying on application logs.
model NowPaymentsIpnEvent {
  id                String    @id @default(uuid())
  eventHash         String    @unique
  orderId           String?
  depositId         String?
  deposit           Deposit?  @relation(fields: [depositId], references: [id], onDelete: SetNull)
  providerPaymentId String?
  paymentStatus     String?
  payload           Json
  processingError   String?
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?

  @@index([depositId])
  @@index([providerPaymentId])
  @@map("nowpayments_ipn_events")
}

/// One row per user-initiated cash-out request. Tokens are debited (via a
/// LedgerEntry) at request time, not at admin fulfillment time -- this
/// reserves the funds immediately so a user can't spend tokens on tasks AND
/// request a withdrawal against the same balance. If an admin rejects the
/// request, a WITHDRAWAL_REVERSED LedgerEntry credits the tokens back.
/// Payout can be sent either manually (admin sends USDT by hand, then calls
/// the resolve endpoint) or automated via NOWPayments' mass-payout API
/// (admin approves -> submits -> provider processes -> settlement-job
/// reconciles). approvedByAdminId/approvedAt record the human checkpoint
/// (Point 1/3 of the payout-automation plan) independently of whether/when
/// the payout was actually submitted to the provider -- submittedToProviderAt
/// marks that separate, later step.
model WithdrawalRequest {
  id                    String           @id @default(uuid())
  walletId              String
  wallet                Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  tokenAmount           Decimal          @db.Decimal(20, 8)
  usdtAmount            Decimal          @db.Decimal(20, 8)
  destinationAddress    String
  destinationCurrency   String           @default("USDT") // user's chosen payout currency, validated at request time against PlatformSettings.allowedWithdrawalCurrencies
  destinationNetwork    String           @default("TRC20") // user's chosen payout network, validated at request time against PlatformSettings.allowedWithdrawalNetworks
  status                WithdrawalStatus @default(PENDING)
  approvedByAdminId     String?
  approvedAt            DateTime?
  provider              String?
  providerPayoutId      String?          @unique
  providerStatus        String?
  providerCurrency      String?
  providerNetwork       String?
  providerAddress       String?
  providerPayload       Json?
  providerError         String?
  submittedToProviderAt DateTime?
  providerSettledAt     DateTime?
  adminNote             String?
  createdAt             DateTime         @default(now())
  resolvedAt            DateTime?

  // Fiat rail (Flutterwave) -- payoutMethod disambiguates which
  // destination-column group below is authoritative for this row; CRYPTO
  // rows leave all of these null and keep using destinationAddress/
  // destinationCurrency/destinationNetwork above. payoutAccountId is a
  // snapshot pointer (details are copied onto the columns below at request
  // time, not live-joined), matching how destinationCurrency/
  // destinationNetwork already snapshot rather than reference live config.
  payoutMethod                          PayoutMethod   @default(CRYPTO)
  payoutAccountId                       String?
  payoutAccount                         PayoutAccount? @relation(fields: [payoutAccountId], references: [id], onDelete: SetNull)
  destinationBankCode                   String?
  destinationBankName                   String?
  destinationAccountNumberEncryptedJson Json?
  destinationAccountNumberMasked        String?
  destinationAccountName                String?
  destinationMobileNetwork              String?
  destinationMobileNumberEncryptedJson  Json?
  destinationMobileNumberMasked         String?
  destinationCountry                    String?
  fiatAmount                            Decimal?       @db.Decimal(20, 8) // local-currency payout amount, snapshotted from usdtAmount at the request-time USD->fiat rate; null for crypto withdrawals
  fiatUsdExchangeRate                   Decimal?       @db.Decimal(18, 6) // local-currency units per USD used to calculate fiatAmount; retained for payout/audit reproducibility

  providerEvents              NowPaymentsPayoutEvent[]
  providerEventsFlutterwave   FlutterwavePayoutEvent[]     @relation("FlutterwavePayoutEvents")
  providerEventsFlutterwaveV4 FlutterwaveV4TransferEvent[] @relation("FlutterwaveV4TransferEvents")
  providerEventsStripe        StripePayoutEvent[]          @relation("StripePayoutEvents")

  @@index([walletId])
  @@index([status])
  @@index([providerPayoutId])
  @@index([payoutAccountId])
  @@map("withdrawal_requests")
}

/// Every NOWPayments mass-payout create/status/verify response we persist
/// for audit and reconciliation. Payouts may require provider-side 2FA, so
/// status changes are not assumed final until NOWPayments reports a terminal
/// state. eventHash dedupes a specific inbound payout callback delivery the
/// same way NowPaymentsIpnEvent.eventHash does for deposits -- app-initiated
/// writes (create/verify/status polls, which aren't inbound callbacks) get a
/// freshly generated one instead so every row still has a stable identity.
model NowPaymentsPayoutEvent {
  id                  String             @id @default(uuid())
  eventHash           String             @unique
  withdrawalRequestId String?
  withdrawalRequest   WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id], onDelete: SetNull)
  providerPayoutId    String?
  eventType           String
  providerStatus      String?
  payload             Json
  processingError     String?
  receivedAt          DateTime           @default(now())

  @@index([withdrawalRequestId])
  @@index([providerPayoutId])
  @@map("nowpayments_payout_events")
}

enum PayoutMethod {
  CRYPTO
  BANK
  MOBILE_MONEY
  STRIPE
}

enum PayoutAccountType {
  BANK
  MOBILE_MONEY
  STABLECOIN_WALLET
  STRIPE_CONNECT
}

enum PayoutAccountVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

/// A trainer's saved, reusable payout destination (Flutterwave bank
/// transfer/mobile money, Stripe Connect, or a self-custody stablecoin
/// wallet), created once via /payout-accounts -- this is the single account
/// list surfaced everywhere a trainer picks where money goes:
/// WithdrawalRequest.payoutAccountId (withdrawal) and
/// P2PTokenOffer.paymentMethodId/P2PTokenTrade.sellerPaymentMethodId (P2P
/// sell side). A snapshot of its resolved details is copied onto the
/// WithdrawalRequest row at withdrawal time, not a live join, so a later
/// edit/delete never retroactively changes a pending withdrawal's
/// destination; P2P instead keeps a live reference (paymentMethodId),
/// nulled out via onDelete: SetNull if the account is later removed.
/// Bank/mobile-money account numbers are AES-256-GCM encrypted at rest
/// (payout-crypto.util.ts) -- only the masked form is ever read back for
/// display. STABLECOIN_WALLET's walletAddress is stored in plaintext
/// (masked form still shown by default) -- unlike a bank account number, a
/// wallet address is meant to be shared to receive funds and isn't secret,
/// so encrypting it adds no real protection.
model PayoutAccount {
  id                  String                          @id @default(uuid())
  userId              String
  user                User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                PayoutAccountType
  country             String // ISO 3166-1 alpha-2, e.g. "NG"
  currency            String // ISO 4217, e.g. "NGN"
  provider            String                          @default("flutterwave")
  isDefault           Boolean                         @default(false)
  verificationStatus  PayoutAccountVerificationStatus @default(UNVERIFIED)
  // Flutterwave v4 Recipient id (POST /transfers/recipients), created lazily
  // the first time a v4 payout targets this account and reused on every
  // later withdrawal from it -- see FlutterwaveV4Service.createRecipient.
  // Unrelated to v3's inline-per-request account_bank/account_number.
  providerRecipientId String?

  // BANK
  bankCode                   String?
  bankName                   String?
  accountNumberEncryptedJson Json?
  accountNumberMasked        String?
  accountName                String? // resolved from the provider at creation time, re-checked before every payout

  // MOBILE_MONEY
  mobileMoneyNetwork             String?
  mobileMoneyNumberEncryptedJson Json?
  mobileMoneyNumberMasked        String?

  // STABLECOIN_WALLET -- self-custody USDT/USDC wallet on a network in
  // PlatformSettings.getAllowedWithdrawalCurrencies/Networks (TRC20 only for
  // now). Set once at creation (OTP-confirmed, see PayoutAccountsController.
  // create) and never edited afterward -- changing wallets means deleting
  // this row (existing OTP-gated delete flow) and creating a new one, same
  // "locked" posture as a saved bank account.
  stablecoinAsset     String? // "USDT" | "USDC"
  stablecoinNetwork   String? // "TRC20"
  walletAddress       String?
  walletAddressMasked String?

  // STRIPE_CONNECT -- a Stripe Connect Express account created on the
  // trainer's behalf (stripe.accounts.create({type:'express'})). We never
  // collect/see raw bank details for this rail: identity + bank-account
  // entry happen entirely on Stripe-hosted pages via an Account Link
  // (StripeConnectService.createOnboardingLink), so there is no
  // *EncryptedJson/*Masked field group here the way BANK/MOBILE_MONEY have.
  // stripeDetailsSubmitted/stripePayoutsEnabled mirror Stripe's own Account
  // object fields of the same name, refreshed either by the
  // account.updated webhook or the manual refresh-status route.
  stripeConnectAccountId String?
  stripeDetailsSubmitted Boolean @default(false)
  stripePayoutsEnabled   Boolean @default(false)

  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  withdrawals     WithdrawalRequest[]
  p2pOffers       P2PTokenOffer[]     @relation("P2POfferPayoutAccount")
  p2pSellerTrades P2PTokenTrade[]     @relation("P2PTradeSellerPaymentMethod")

  @@index([userId])
  @@index([userId, isDefault])
  @@map("payout_accounts")
}

/// Every distinct, signature-verified Flutterwave webhook payload (funding
/// side) -- mirrors NowPaymentsIpnEvent's role for the crypto rail, kept as
/// a separate table (not a shared/generalized provider-discriminated table)
/// so this new rail cannot risk the already-working NOWPayments read/write
/// paths.
model FlutterwaveWebhookEvent {
  id              String    @id @default(uuid())
  eventHash       String    @unique
  txRef           String?
  depositId       String?
  deposit         Deposit?  @relation(fields: [depositId], references: [id], onDelete: SetNull)
  flutterwaveTxId String?
  eventType       String?
  providerStatus  String?
  payload         Json
  processingError String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@index([depositId])
  @@index([flutterwaveTxId])
  @@map("flutterwave_webhook_events")
}

/// Every Flutterwave transfer create/status-poll/webhook response we
/// persist for audit and reconciliation -- mirrors NowPaymentsPayoutEvent's
/// role for the crypto rail. eventHash dedupes an inbound webhook delivery;
/// app-initiated writes (create/poll, not inbound callbacks) get a freshly
/// generated one so every row still has a stable identity.
model FlutterwavePayoutEvent {
  id                  String             @id @default(uuid())
  eventHash           String             @unique
  withdrawalRequestId String?
  withdrawalRequest   WithdrawalRequest? @relation("FlutterwavePayoutEvents", fields: [withdrawalRequestId], references: [id], onDelete: SetNull)
  providerPayoutId    String?
  eventType           String
  providerStatus      String?
  payload             Json
  processingError     String?
  receivedAt          DateTime           @default(now())

  @@index([withdrawalRequestId])
  @@index([providerPayoutId])
  @@map("flutterwave_payout_events")
}

/// v4 counterpart to FlutterwaveWebhookEvent -- kept as a separate table
/// rather than reused, same reasoning FlutterwaveWebhookEvent's own doc
/// comment gives for not sharing NowPaymentsIpnEvent's table: a different
/// provider API version must not be able to risk the already-working v3
/// read/write paths. v4 charges (bank-transfer virtual account or mobile
/// money) fire "charge.completed"; this table is the audit/dedup log for
/// those webhook deliveries.
model FlutterwaveV4ChargeEvent {
  id              String    @id @default(uuid())
  eventHash       String    @unique
  chargeId        String?
  reference       String?
  depositId       String?
  deposit         Deposit?  @relation(fields: [depositId], references: [id], onDelete: SetNull)
  eventType       String?
  providerStatus  String?
  payload         Json
  processingError String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@index([depositId])
  @@index([chargeId])
  @@map("flutterwave_v4_charge_events")
}

/// v4 counterpart to FlutterwavePayoutEvent -- transfers created via
/// FlutterwaveV4Service.createTransfer (Recipient + Sender model) fire
/// "transfer.disburse"/"transfer.reversal", not v3's "transfer.completed".
/// Kept separate from FlutterwavePayoutEvent for the same reason
/// FlutterwaveV4ChargeEvent is kept separate from FlutterwaveWebhookEvent.
model FlutterwaveV4TransferEvent {
  id                  String             @id @default(uuid())
  eventHash           String             @unique
  transferId          String?
  reference           String?
  withdrawalRequestId String?
  withdrawalRequest   WithdrawalRequest? @relation("FlutterwaveV4TransferEvents", fields: [withdrawalRequestId], references: [id], onDelete: SetNull)
  eventType           String?
  providerStatus      String?
  payload             Json
  processingError     String?
  receivedAt          DateTime           @default(now())

  @@index([withdrawalRequestId])
  @@index([transferId])
  @@map("flutterwave_v4_transfer_events")
}

/// Third fiat payout rail alongside Flutterwave v3/v4 -- Stripe Connect
/// Express transfers, for trainers whose country/currency Stripe covers.
/// Mirrors FlutterwavePayoutEvent's role exactly: every
/// StripeConnectService.createTransfer/getPayoutStatus response, plus
/// inbound "transfer.reversed"/"account.updated" webhook deliveries, is
/// persisted here for audit and reconciliation. Kept as its own table
/// rather than folded into FlutterwavePayoutEvent for the same "a new rail
/// must not risk an already-working provider's read/write paths" reasoning
/// FlutterwaveV4TransferEvent's doc comment gives.
model StripePayoutEvent {
  id                  String             @id @default(uuid())
  eventHash           String             @unique
  withdrawalRequestId String?
  withdrawalRequest   WithdrawalRequest? @relation("StripePayoutEvents", fields: [withdrawalRequestId], references: [id], onDelete: SetNull)
  providerPayoutId    String?
  eventType           String
  providerStatus      String?
  payload             Json
  processingError     String?
  receivedAt          DateTime           @default(now())

  @@index([withdrawalRequestId])
  @@index([providerPayoutId])
  @@map("stripe_payout_events")
}

enum P2POfferType {
  SELL
  BUY
}

enum P2POfferStatus {
  ACTIVE
  RESERVED
  EXPIRED
  CANCELLED
  COMPLETED
  DISPUTED
}

enum P2PTradeStatus {
  AWAITING_PAYMENT
  PAID_MARKED
  RELEASED
  CANCEL_PENDING
  CANCELLED
  DISPUTED
  EXPIRED
}

enum P2PDisputeStatus {
  OPEN
  RESOLVED_BUYER
  RESOLVED_SELLER
}

model P2PMarketSettings {
  id                          String   @id @default("default")
  enabled                     Boolean  @default(false)
  sellOffersEnabled           Boolean  @default(false)
  buyRequestsEnabled          Boolean  @default(false)
  minTradeTokens              Decimal  @default(1) @db.Decimal(20, 8)
  maxTradeTokens              Decimal  @default(1000) @db.Decimal(20, 8)
  paymentWindowMinutes        Int      @default(15)
  cancelGraceMinutes          Int      @default(5)
  offerExpiryMinutes          Int      @default(1440)
  maxOpenOffersPerUser        Int      @default(5)
  maxOpenTradesPerUser        Int      @default(3)
  allowedFiatCurrencies       String   @default("NGN")
  allowedPaymentMethods       String   @default("BANK_TRANSFER")
  disputeWindowMinutes        Int      @default(1440)
  adminOtpRequiredForDisputes Boolean  @default(true)
  updatedAt                   DateTime @updatedAt
  createdAt                   DateTime @default(now())

  @@map("p2p_market_settings")
}

model P2PTokenOffer {
  id               String         @id @default(uuid())
  type             P2POfferType
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenAmount      Decimal        @db.Decimal(20, 8)
  remainingTokens  Decimal        @db.Decimal(20, 8)
  fiatAmount       Decimal        @db.Decimal(20, 8)
  fiatCurrency     String
  paymentMethod    String
  paymentMethodId  String?
  paymentMethodRef PayoutAccount? @relation("P2POfferPayoutAccount", fields: [paymentMethodId], references: [id], onDelete: SetNull)
  status           P2POfferStatus @default(ACTIVE)
  expiresAt        DateTime
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  trades P2PTokenTrade[]

  @@index([type, status, expiresAt])
  @@index([userId, status])
  @@map("p2p_token_offers")
}

model P2PTokenTrade {
  id                      String         @id @default(uuid())
  offerId                 String
  offer                   P2PTokenOffer  @relation(fields: [offerId], references: [id], onDelete: Restrict)
  buyerId                 String
  buyer                   User           @relation("P2PBuyerTrades", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId                String
  seller                  User           @relation("P2PSellerTrades", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerPaymentMethodId   String?
  sellerPaymentMethod     PayoutAccount? @relation("P2PTradeSellerPaymentMethod", fields: [sellerPaymentMethodId], references: [id], onDelete: SetNull)
  tokenAmount             Decimal        @db.Decimal(20, 8)
  fiatAmount              Decimal        @db.Decimal(20, 8)
  fiatCurrency            String
  paymentMethod           String
  status                  P2PTradeStatus @default(AWAITING_PAYMENT)
  paymentDeadlineAt       DateTime
  cancelRequestedByUserId String?
  cancelAvailableAt       DateTime?
  paidAt                  DateTime?
  releasedAt              DateTime?
  cancelledAt             DateTime?
  disputedAt              DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  dispute P2PDispute?

  @@index([buyerId, status, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([offerId])
  @@index([status, paymentDeadlineAt])
  @@map("p2p_token_trades")
}

model P2PDispute {
  id                String           @id @default(uuid())
  tradeId           String           @unique
  trade             P2PTokenTrade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  raisedByUserId    String
  raisedByUser      User             @relation("P2PDisputesRaised", fields: [raisedByUserId], references: [id], onDelete: Cascade)
  reason            String
  evidenceUrl       String?
  status            P2PDisputeStatus @default(OPEN)
  resolvedByAdminId String?
  resolvedByAdmin   User?            @relation("P2PDisputesResolved", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)
  resolutionNote    String?
  createdAt         DateTime         @default(now())
  resolvedAt        DateTime?

  @@index([status, createdAt])
  @@map("p2p_disputes")
}

/// Fixed platform referral settings. Admins don't create referral campaigns;
/// they only tune these two fractional rates/toggles:
/// - funding bonus: credited to the referrer when a referred user funds tokens
/// - payout bonus: deducted from a referred user's scored training payout and
///   remitted to the referrer when that payout is credited
model ReferralSettings {
  id                  String   @id @default("default")
  fundingBonusRate    Decimal  @default(0.10) @db.Decimal(5, 4)
  fundingBonusEnabled Boolean  @default(true)
  payoutBonusRate     Decimal  @default(0.00) @db.Decimal(5, 4)
  payoutBonusEnabled  Boolean  @default(false)
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@map("referral_settings")
}

/// Admin-editable platform settings that previously only existed as env-var
/// defaults (see token-rate.util.ts, mail.service.ts). Each field is
/// nullable -- null means "fall back to the env var default", so this table
/// can ship with zero rows and every existing deployment keeps working
/// unchanged until an admin explicitly overrides a value from the Settings
/// UI. Same id:'default' singleton-row pattern as ReferralSettings.
model PlatformSettings {
  id                                     String    @id @default("default")
  tokenUsdRate                           Decimal?  @db.Decimal(10, 6) // overrides TOKEN_USD_RATE when set
  minWithdrawalTokens                    Decimal?  @db.Decimal(20, 8) // overrides MIN_WITHDRAWAL_TOKENS when set
  minWalletBalanceTokens                 Decimal   @default(0) @db.Decimal(20, 8) // reserve every trainer must keep in their wallet -- a withdrawal request may never bring wallet.balance below this floor; see WalletController.validateCommonWithdrawalRequirements
  minCompletedTasksForWithdrawal         Int? // overrides MIN_COMPLETED_TASKS_FOR_WITHDRAWAL when set; trainer must have this many SETTLED wordRecordings before any withdrawal (fiat or crypto) is allowed
  resendFromAddress                      String? // overrides RESEND_FROM_ADDRESS when set
  leadsNotificationAddress               String? // overrides LEADS_NOTIFICATION_ADDRESS when set
  referralCookiePersistSeconds           Int? // overrides REFERRAL_COOKIE_PERSIST_SECONDS when set; how long referral attribution cookie persists on register flows
  referralInviteExpirySeconds            Int? // overrides REFERRAL_INVITE_EXPIRY_SECONDS when set; pending invite lifetime before lazy deletion
  wordTrainingRecordingTimeoutSeconds    Int? // overrides WORD_TRAINING_RECORDING_TIMEOUT_SECONDS when set; per-WORD recording seconds in the trainer live recording flow -- the frontend multiplies this by the assignment's word count (splitting promptText on whitespace) to get the round's total countdown, so a 5s/word setting gives a 1-word assignment 5s and a 5-word sentence 25s
  wordTrainingRecordingMaxTimeoutSeconds Int? // overrides WORD_TRAINING_RECORDING_MAX_TIMEOUT_SECONDS when set; hard ceiling on the total per-round countdown after the per-word multiplication, so an unusually long prompt can't produce a runaway timer
  trainingPayoutBonusCapMultiple         Decimal?  @db.Decimal(5, 2) // overrides TRAINING_PAYOUT_BONUS_CAP_MULTIPLE when set; caps the score-scaled bonus at this multiple of tokensSpent (see computeTrainingPayout)
  taskTokenCost                          Decimal?  @db.Decimal(20, 8) // overrides TASK_TOKEN_COST when set; tokens debited from a trainer's wallet per submission
  reverseWordTrainingEnabled             Boolean   @default(false)
  adminPayoutOtpEnabled                  Boolean   @default(false) // when true, admin/training-payouts and admin/withdrawals/:id/resolve require the acting admin to verify an emailed OTP first
  sessionIdleTimeoutMinutes              Int       @default(30) // minutes of inactivity before any authenticated session (trainer or admin) is force-signed-out and must reauthenticate -- enforced both client-side (activity-tracking sign-out) and server-side (frontend/proxy.ts compares against the JWT's lastActiveAt claim, so it can't be bypassed by disabling client JS)
  sessionMaxHours                        Int       @default(12) // absolute session ceiling in hours, independent of activity -- forces a fresh login at least this often even for a continuously-active session, checked against the JWT's iat in frontend/lib/auth-options.ts and frontend/proxy.ts
  phoneVerificationRequired              Boolean   @default(true) // when false: phone numbers can be saved without SMS verification, the standing phoneVerifiedAt gate is skipped for withdrawals and P2P trading, and P2P offer create/accept require an emailed OTP instead (see P2pService.createOffer/acceptOffer) -- withdrawals already have their own per-transaction email OTP regardless of this flag
  manualPhoneVerificationEnabled         Boolean   @default(true) // lets trainers request admin-assisted WhatsApp phone verification when SMS delivery is unreliable
  manualPhoneVerificationFeeTokens       Decimal   @default(1) @db.Decimal(20, 8) // DL fee charged when a trainer creates a manual WhatsApp verification request
  manualPhoneVerificationWhatsappNumber  String    @default("1234567890") // admin-operated WhatsApp number trainers are instructed to message with their generated code
  manualPhoneVerificationExpiryMinutes   Int       @default(30) // generated WhatsApp verification codes expire after this many minutes
  startupBonusAmount                     Decimal?  @db.Decimal(20, 8) // one-time DL amount credited (as a STARTUP_BONUS ledger entry) the first time a user verifies their email; null or 0 means the bonus is off
  tawkToEnabled                          Boolean   @default(false) // master switch for the Tawk.to live-chat widget; the frontend only loads the widget script when this is true AND both IDs below are set
  tawkToPropertyId                       String? // Tawk.to "Property ID" from the widget's embed snippet -- the first path segment of https://embed.tawk.to/<propertyId>/<widgetId>
  tawkToWidgetId                         String? // Tawk.to "Widget ID" from the same embed snippet -- the second path segment
  supportChatMode                        String    @default("TAWK") // NONE | TAWK | AI; TAWK remains the compatibility default for existing deployments
  pwaInstallPromptEnabled                Boolean   @default(true) // master switch for authenticated PWA install prompts; the avatar-menu install action remains available when supported
  pwaInstallPromptReminderMinutes        Int       @default(60) // minimum interval before a dismissed PWA install prompt may reappear on the same device/account
  weeklyTrainerReportEnabled             Boolean   @default(true) // master switch for the Monday weekly-trainer-report email (weekly-trainer-report.ts CronJob); checked once at job start, gates the whole run rather than per-recipient
  wordStuckTimeoutMinutes                Int       @default(1440) // minutes an ENGLISH_TO_DIALECT WordRecording can stay PENDING (unmatched by reverse-validation) before settlement-job auto-refunds its locked tokens
  scoringSlaMinutes                      Int       @default(60) // minutes a WordRecording can stay unscored before settlement-job resolves it via noFailOnTrainEnabled (synthetic score) or a plain refund
  auditHoldEveryNSubmissions             Int       @default(500) // WordsService.createRecording puts a trainer on audit hold every time their lifetime WordRecording count crosses a multiple of this; 0 disables the feature entirely (no automatic holds)
  settlementDelayMinutes                 Int       @default(0) // minutes settlement-job waits after scoredAt before crediting a SCORED wordRecording's payout -- 0 settles as soon as the next run sees it scored; can be set well past 24h (1440) for a longer admin review window
  noFailOnTrainEnabled                   Boolean   @default(false) // when true, a task still unscored past scoringSlaMinutes is paid out at a random score in [minScoreRange, maxScoreRange] instead of just refunded -- guarantees payment for completed work even if consensus/reverse-validation never resolves it
  minScoreRange                          Decimal   @default(10) @db.Decimal(5, 2) // lower bound (%) of every scored payout's bonus -- random synthetic-timeout scores are drawn from this range; real (consensus/exact-match) scores' compositeScore is clamped into this range too once qualityGateEnabled
  maxScoreRange                          Decimal   @default(30) @db.Decimal(5, 2) // upper bound (%) of every scored payout's bonus -- see minScoreRange
  llmGenerationEnabled                   Boolean   @default(false) // master kill switch for word-generator-job; job no-ops when false
  llmProviderOrder                       String    @default("openai,deepseek,anthropic") // CSV fallback-try order, must be a permutation of {openai,deepseek,anthropic}, validated app-side
  llmWordsPerItem                        Int       @default(1) // 1 = single word -> Word table; 2-20 = phrase/sentence -> Sentence table -- validated 1-20 in UpdatePlatformSettingsDto
  singleWordGenerationEnabled            Boolean   @default(true) // narrower than llmGenerationEnabled: gates ONLY the llmWordsPerItem===1 (single-word -> Word table) branch of word-generator-job's main run(). When false, that branch is skipped entirely regardless of llmWordsPerItem's stored value -- composition/multi-word generation (llmWordsPerItem>=2) and runPhraseTierGeneration are unaffected and keep running on their own settings. Set llmWordsPerItem to 2-20 separately to actually get composition output (short phrases up through full sentences) from the main pass while this is off.
  llmItemsPerRun                         Int       @default(15) // batch size requested from the LLM per scheduled run
  llmMaxTotalGeneratedItems              Int       @default(5000) // hard global cap on generated source content volume (Word rows when llmWordsPerItem=1, otherwise en-us Sentence rows); word-generator-job stops generating brand-new content once this total is reached
  llmMaxPoolPerDialect                   Int       @default(50) // gate on total content pool size, not just batch size: word-generator-job skips generating new Sentence/Word translations for a dialect once that dialect's combined active-Sentence + translated-Word count reaches this ceiling. Peer reverse-validation needs multiple trainers submitting the *same* sentence/word -- an unbounded pool spread across too few trainers means no single item ever accumulates enough reverse-validations, so the pool per dialect is grown deliberately (raise this setting) as that dialect's active trainer base grows, not automatically every run
  llmBackfillItemsPerDialectPerRun       Int       @default(10) // per scheduled run, how many pre-existing English Word rows (oldest first) a single under-cap dialect may have translated into it, before word-generator-job moves on to generating brand-new English content. Without this, a newly-enabled dialect starts its pool at 0 and only grows via the shared trickle of NEW content each run (llmItemsPerRun), staying permanently behind dialects enabled earlier -- this lets it instead catch up by draining the existing backlog, bounded so one far-behind dialect can't consume an entire run's LLM budget
  keyboardLayoutMaxLength                Int       @default(1000) // maximum number of characters an admin may save in a dialect's virtual keyboard layout
  submissionRateLimitEnabled             Boolean   @default(false) // master switch for per-trainer submission throttling (SubmissionRateLimitGuard on POST /words/recordings); off by default so existing deployments are unaffected until an admin opts in
  submissionRateLimitPerHour             Int       @default(120) // max word/sentence recordings a single trainer may submit per rolling hour while submissionRateLimitEnabled is on
  qracEnabled                            Boolean   @default(false) // master switch for the Quality Recordings Affirmation Check (QRAC); when false, WordsService.nextAssignment never blocks on it regardless of mode or interval
  qracRequiredAtSessionStart             Boolean   @default(false) // when true, QRAC must be signed before the first assignment in every new training session; when false, QRAC uses the periodic qracIntervalMinutes mode instead
  qracIntervalMinutes                    Int       @default(30) // trainer must re-sign the QRAC checklist this often during an open word-training session when qracRequiredAtSessionStart is false; checked against TrainingSession.lastQracAt (or startedAt if never signed) on every nextAssignment call
  qualityGateEnabled                     Boolean   @default(false) // master kill switch for the quality-gate-worker's effect on payout; worker still runs and records noise/quality/livenessScore when false, but compositeScore computation falls back to the raw score (today's behavior) until enabled
  qualityWeightConsensus                 Decimal   @default(60) @db.Decimal(5, 2) // weight (%) given to the real score (consensus agreement / exact-match) in compositeScore's blend
  qualityWeightNoise                     Decimal   @default(15) @db.Decimal(5, 2) // weight (%) given to noiseScore in compositeScore's blend
  qualityWeightQuality                   Decimal   @default(10) @db.Decimal(5, 2) // weight (%) given to qualityScore in compositeScore's blend
  qualityWeightLiveness                  Decimal   @default(15) @db.Decimal(5, 2) // weight (%) given to livenessScore in compositeScore's blend -- the four qualityWeight* fields must sum to 100, validated in PlatformSettingsService.update
  qualityWeightAsrMatch                  Decimal   @default(0) @db.Decimal(5, 2) // weight (%) given to WordRecording.asrMatchScore in computeWordRecordingCompositeScore's blend. Deliberately NOT part of the four qualityWeight*'s sum-to-100 group: defaults to 0 so this feature ships inert until an admin opts in, additive rather than carved out of the existing four's budget. Validated independently (>= 0) in PlatformSettingsService.update
  spellingNormalizationEnabled           Boolean   @default(false) // master kill switch for AI spelling normalization on ENGLISH_TO_DIALECT word recordings; writes WordRecording.normalizedTranslationText only, never affects scoring
  speechExpressionEnabled                Boolean   @default(false) // master kill switch for the speech-expression analysis pass (emotion/tone/style/speed/energy/prosodyMetrics) in quality-gate-worker. When false, the worker skips the analysis entirely (not "computes but hides" -- unlike qualityGateEnabled, there's no downstream scoring use for this to gate, and emotion classification has a real per-job CPU cost worth skipping when unused). Purely descriptive/informational output -- deliberately has NO qualityWeight* counterpart and never feeds compositeScore/payout (see docs/Dialect-Library-Speech-Expression-Metadata-Plan.md's "never permanently bake into scoring" principle)
  spellingNormalizationProviderOrder     String    @default("openai,deepseek,anthropic") // CSV fallback-try order for spelling normalization, same permutation rules as llmProviderOrder
  wordTrainingEnabled                    Boolean   @default(true) // admin content gate: when false, WordsService.nextAssignment's ENGLISH_TO_DIALECT fallback never serves a single Word -- only Sentence content (subject to sentenceTrainingEnabled and phraseEscalationEnabled/tier gating) is offered. PlatformSettingsService.update refuses to save both this and sentenceTrainingEnabled as false at once, since that would leave ENGLISH_TO_DIALECT with no source at all. Independent of reverseWordTrainingEnabled, which controls the separate DIALECT_TO_ENGLISH reverse-validation flow and is unaffected by either content gate.
  sentenceTrainingEnabled                Boolean   @default(true) // admin content gate: when false, WordsService.nextAssignment never serves Sentence content regardless of phraseEscalationEnabled/a trainer's phrase tier -- only single Word content is offered. See wordTrainingEnabled's doc comment for the both-false guard and the independence from reverseWordTrainingEnabled.
  phraseEscalationEnabled                Boolean   @default(false) // master kill switch for Sentence-sourced ENGLISH_TO_DIALECT escalation -- when false, WordsService.nextAssignment never escalates a trainer to sentence content regardless of their lifetime WordRecording count (see phrase-tiers.const.ts, pickSentenceSource); separate from phraseTierGenerationEnabled below, which gates word-generator-job's pool-building pass instead, so the pool can pre-populate before assignment goes live
  phraseTierGenerationEnabled            Boolean   @default(false) // master kill switch for word-generator-job's per-tier sentence composition pass (runPhraseTierGeneration); job's regular single-word/composition run is unaffected when this is false
  phraseTierItemsPerTierPerRun           Int       @default(3) // how many new sentences word-generator-job composes PER TIER (see phrase-tiers.const.ts) per scheduled run, same convention as llmItemsPerRun above but scoped per-tier instead of globally
  testimonyEnabled                       Boolean   @default(false) // master switch for prompting trainers to give a testimony (trainer dashboard banner) and for the public homepage carousel; when false neither the banner nor any carousel content appears, and submission is rejected server-side
  testimonyMaxTextLength                 Int       @default(200) // max characters for a TEXT testimony, enforced both client-side (textarea maxLength) and server-side (TestimonialsService.submit)
  testimonyMaxVideoSeconds               Int       @default(30) // hard cap on a VIDEO testimony's recording length, enforced client-side same as WordTrainingDialog's maxRecordingMs pattern, and re-validated server-side against the submitted durationMs
  testimonyLandingLimit                  Int       @default(12) // approved, visible testimonials shown on the landing page; the full public archive remains paginated at /testimonials
  testimonyRewardTokens                  Decimal   @default(5) @db.Decimal(20, 8) // legacy single reward retained only for migration compatibility; new approvals use the format-specific values below
  testimonyTextRewardTokens              Decimal   @default(5) @db.Decimal(20, 8) // DL reward credited when an admin approves a TEXT testimony
  testimonyVideoRewardTokens             Decimal   @default(5) @db.Decimal(20, 8) // DL reward credited when an admin approves a VIDEO testimony
  smsSenderId                            String? // Overrides TERMII_SENDER_ID/SMSLIVE247_SENDER_ID/AFRICASTALKING_SENDER_ID for every SMS provider (Termii, SMSLive247, Africa's Talking, and SMSLive247's native-OTP route) when set -- null/unset falls back to each provider's own env var, so this stays a no-op until an admin fills it in. Twilio has no equivalent (it sends from a purchased phone number, not a named sender ID).
  smsProviderOrder                       String    @default("termii,twilio,africastalking") // CSV fallback-try order for phone-verification SMS OTPs, must be a permutation of {termii,twilio,africastalking}, validated app-side like llmProviderOrder -- smslive247 is not a fallback-chain member (see smslive247NativeOtpEnabled), it can't fire-and-forget an arbitrary code on their OTP-compliant route
  smslive247NativeOtpEnabled             Boolean   @default(false) // when true, phone verification (Profile > Phone number) bypasses OtpCode/the SMS fallback chain entirely and uses SMSLive247's own token-generate/verify API end-to-end, since their OTP-compliant route generates the code itself and verifies it on their side, not ours
  smsTransactionalOtpEnabled             Boolean   @default(true) // sends application-generated SMS OTPs through the transactional provider chain as the raw code only; SMSLive247 is first by default. When false, phone verification may use SMSLive247's native token API or the legacy OTP chain.
  smsTransactionalProviderOrder          String    @default("smslive247,termii,twilio,africastalking") // CSV fallback-try order for transactional SMS and direct-code OTP delivery; SMSLive247 is first by default and the other providers are fallbacks.
  p2pSmsTradeCreatedEnabled              Boolean   @default(false) // SMS both parties when a P2P trade is created (acceptOffer)
  p2pSmsPaymentMarkedEnabled             Boolean   @default(false) // SMS the seller when the buyer marks a trade paid (markPaid)
  p2pSmsTokensReleasedEnabled            Boolean   @default(false) // SMS the buyer when the seller releases tokens (release)
  p2pSmsCancelledEnabled                 Boolean   @default(false) // SMS the seller when a trade is cancelled/expired/refunded (cancelTrade, refundTradeToSeller, dispute resolved to seller) and the non-raiser when a dispute is raised (raiseDispute)
  walletSmsWithdrawalPaidEnabled         Boolean   @default(false) // SMS the trainer once their withdrawal payout actually settles (PAID), across every payout rail (NOWPayments, Flutterwave v3/v4, Stripe) and the admin manual "mark paid" override
  walletSmsWithdrawalRejectedEnabled     Boolean   @default(false) // SMS the trainer when an admin rejects their withdrawal request (admin/withdrawals/:id/resolve, outcome=reject) -- the locked DL is returned to their spendable balance at the same time
  walletSmsWithdrawalFailedEnabled       Boolean   @default(false) // SMS the trainer when a payout provider reports the withdrawal failed after submission (distinct from an admin rejecting it before submission)
  walletSmsDepositConfirmedEnabled       Boolean   @default(false) // SMS the trainer once a crypto or fiat deposit is confirmed and DL is credited to their wallet
  referralSmsFundingBonusEnabled         Boolean   @default(false) // SMS the referrer when they're credited a funding bonus off a referral's deposit (only fires if ReferralSettings.fundingBonusEnabled is also on)
  referralSmsPayoutBonusEnabled          Boolean   @default(false) // SMS the referrer when they're credited a payout bonus off a referral's training-payout settlement (only fires if ReferralSettings.payoutBonusEnabled is also on)
  validationRewardPerRecording           Decimal   @default(0) @db.Decimal(20, 8) // flat DL amount credited per VALID ValidatorDeckItem when its containing deck is published (docs/validators.md) -- 0 disables validator payouts entirely; Phase 1 only reads this for the unpaid "expected earning" preview, actual crediting lands in a later phase
  validatorDeckMaxItems                  Int       @default(2000) // cap on ValidatorDeckItem rows per ValidatorDeck; 0 = uncapped
  cryptoWithdrawalsEnabled               Boolean   @default(true) // master kill switch -- when false, both wallet/withdrawals/otp and wallet/withdrawals reject new withdrawal requests outright
  nowPaymentsPayoutsEnabled              Boolean   @default(false) // when false, admin/withdrawals/:id/submit-nowpayments is disabled -- admins can still resolve withdrawals manually (outcome=paid) while this is off, which is the safe default until payout credentials/allow-lists are configured
  allowedWithdrawalCurrencies            String    @default("USDT") // CSV of currencies a withdrawal's destinationCurrency may be, validated app-side against NowPaymentsService's supported set (USDT, USDC)
  allowedWithdrawalNetworks              String    @default("TRC20") // CSV of networks a withdrawal's destinationNetwork may be for its chosen currency, validated app-side against NowPaymentsService's supported set (TRC20, ERC20, BEP20, SOL, POLYGON)
  withdrawalFeeMode                      String    @default("platform") // "platform" (fee absorbed by platform, user receives full tokenAmount worth) or "user" (fee deducted from the payout, see withdrawalFeeTokenAmount/withdrawalFeePercent)
  withdrawalFeeTokenAmount               Decimal   @default(0) @db.Decimal(20, 8) // flat token fee deducted from payout when withdrawalFeeMode="user" and this is > 0 (takes precedence over withdrawalFeePercent if both are set)
  withdrawalFeePercent                   Decimal   @default(0) @db.Decimal(5, 2) // percentage fee (0-100) deducted from payout when withdrawalFeeMode="user" and withdrawalFeeTokenAmount is 0
  autoSubmitAfterApproval                Boolean   @default(false) // when true, admin/withdrawals/:id/approve immediately submits to NOWPayments in the same call instead of leaving it APPROVED for a separate submit step -- defaults off per the payout-automation plan's explicit caution
  isKycRequiredForWithdrawals            Boolean   @default(false) // master kill switch -- when true, validateWithdrawalRequest (crypto + fiat) requires User.kycStatus="APPROVED" once tokenAmount >= kycMinWithdrawalTokens; off by default until Didit credentials are configured
  kycMinWithdrawalTokens                 Decimal   @default(0) @db.Decimal(20, 8) // withdrawals below this amount skip the KYC gate even when isKycRequiredForWithdrawals is on -- lets ops require KYC only above a threshold without a code change
  isKycRequiredOnboarding                Boolean   @default(false) // when true, the frontend prompts a trainer to verify right after onboarding completes. Purely a UX prompt -- "do this later" has no separate enforcement of its own; the trainer simply remains subject to whatever isKycRequiredForWithdrawals/kycMinWithdrawalTokens already gate at withdrawal time
  kycAutoCancelStaleEnabled              Boolean   @default(false) // master kill switch -- when true, a scheduled job flips any KycVerification/User stuck in NOT_STARTED/IN_PROGRESS/IN_REVIEW for longer than kycAutoCancelStaleMinutes to ABANDONED, freeing the trainer to start a fresh Didit session; off by default so no existing in-flight verification is affected until an admin opts in
  kycAutoCancelStaleMinutes              Int       @default(60) // how long a KycVerification may sit in a non-terminal status before the auto-cancel job abandons it, once kycAutoCancelStaleEnabled is on
  isFlutterwaveFundingEnabled            Boolean   @default(false) // master kill switch -- when false, wallet/deposits/flutterwave rejects new funding requests outright; off by default until Flutterwave credentials/allow-lists are configured
  isFlutterwavePayoutsEnabled            Boolean   @default(false) // when false, admin/withdrawals/:id/submit-flutterwave is disabled -- admins can still resolve fiat withdrawals manually (outcome=paid) while this is off
  allowedFlutterwaveCurrencies           String    @default("NGN,GHS,KES,UGX,ZAR,TZS") // CSV of currencies a fiat withdrawal/deposit's currency may be, validated app-side
  allowedFlutterwaveCountries            String    @default("NG,GH,KE,UG,ZA,TZ") // CSV of ISO 3166-1 alpha-2 countries a PayoutAccount/deposit's country may be, validated app-side
  isFlutterwaveV4Enabled                 Boolean   @default(false) // routes fiat deposit/payout/payout-account creation through FlutterwaveV4Service (OAuth2, Customer + PaymentMethod + Charge, Recipient + Sender + Transfer) instead of the v3 hosted-checkout-link flow. Off by default -- v3 stays the active rail; a withdrawal/deposit created under v4 always continues being serviced by v4 regardless of later toggling, via its own stored provider tag ("flutterwave-v4" vs "flutterwave")
  flutterwaveV4SenderId                  String? // Flutterwave v4 Sender id (POST /transfers/senders, type=generic_sender) -- one platform-level identity, not per-trainer, created lazily the first v4 payout is submitted and reused on every later one
  isStripePayoutsEnabled                 Boolean   @default(false) // master kill switch -- when false, POST /payout-accounts rejects STRIPE_CONNECT creation and admin/withdrawals/:id/submit-stripe is disabled; admins can still resolve fiat withdrawals manually (outcome=paid) while this is off, same posture as isFlutterwavePayoutsEnabled. Off by default until STRIPE_SECRET_KEY/STRIPE_CONNECT_WEBHOOK_SECRET are configured
  authMaintenanceEnabled                 Boolean   @default(false) // master switch for the maintenance window; the five scope flags below decide what it actually blocks while on. PlatformSettingsService auto-clears this the first time any check runs after authMaintenanceUntil passes, so the admin toggle self-resets rather than staying on indefinitely
  authMaintenanceUntil                   DateTime? // scheduled end of the maintenance window
  authMaintenanceMessage                 String? // optional admin-authored note shown alongside the countdown on the login/signup pages and the logged-out notice
  authMaintenanceBlockLogin              Boolean   @default(true) // blocks POST /auth/login (credentials + OTP-issuance step) while maintenance is enabled
  authMaintenanceBlockSignup             Boolean   @default(true) // blocks POST /auth/register and /auth/magic-link/request (magic-link request creates the account on first use, so it's signup, not just login) while maintenance is enabled
  authMaintenanceBlockSessions           Boolean   @default(false) // when true, JwtAuthGuard rejects already-authenticated requests too (not just new login/signup), logging every active session out until the window ends -- subject to the role excludes below
  authMaintenanceExcludeAdmin            Boolean   @default(true) // when authMaintenanceBlockSessions is on, ADMIN-role sessions are still exempted by default so an admin can reach Settings to end maintenance early
  authMaintenanceExcludePartner          Boolean   @default(false) // when authMaintenanceBlockSessions is on, whether PARTNER-role sessions are exempted too
  registerRateLimitPerHour               Int? // overrides REGISTER_RATE_LIMIT_PER_HOUR when set; max POST /auth/register requests per IP per rolling hour (see PlatformRateLimitGuard)
  landingShowCountries                   Boolean   @default(true) // per-card visibility toggles for the landing page's 5-stat row (GeoController.getStats/LandingStats) -- hiding a stat only affects display, never stops it being computed
  landingShowDialects                    Boolean   @default(true)
  landingShowTrainers                    Boolean   @default(true)
  landingShowPoolVolume                  Boolean   @default(true)
  landingShowPayout                      Boolean   @default(true)
  updatedAt                              DateTime  @updatedAt
  createdAt                              DateTime  @default(now())

  @@map("platform_settings")
}

/// Admin-editable third-party API credentials (Admin Settings -> "API Access
/// Tokens" tab) -- e.g. the Hugging Face token whisper-worker needs to pull
/// gated NCAIR1 Whisper checkpoints. Deliberately a separate table, not more
/// columns on PlatformSettings: every PlatformSettings field is echoed back
/// verbatim by getForAdmin()/update(), which is fine for a sender ID but
/// wrong for a bearer token (must never round-trip to the frontend in
/// plaintext after save). `key` is a small fixed vocabulary (e.g.
/// "huggingface"), not user-defined -- see ApiAccessTokensService's KNOWN_KEYS.
/// `value` is AES-256-GCM ciphertext (see crypto.util.ts), keyed by the
/// API_TOKEN_ENCRYPTION_KEY env var that both api and whisper-worker read;
/// `iv`/`authTag` are the per-encryption nonce/tag GCM requires to decrypt.
/// `lastFour` is plaintext -- the last 4 characters of the real token, kept
/// only so the admin UI can show "...a1b2" without ever decrypting for
/// display. No OTP gate on writes (see SettingsController's instant-save
/// posture for the rest of admin settings) -- this is a credential swap, not
/// a funds-movement action.
model ApiAccessToken {
  key             String   @id // e.g. "huggingface" -- see ApiAccessTokensService.KNOWN_KEYS
  encryptedValue  String // AES-256-GCM ciphertext, base64
  iv              String // base64, unique per encryption
  authTag         String // base64 GCM auth tag
  lastFour        String // last 4 chars of the real token, plaintext, display-only
  updatedByUserId String?
  updatedBy       User?    @relation("ApiAccessTokenUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("api_access_tokens")
}

/// One row per "Subscribe to voice data" form submission from the landing
/// page's data-buyer CTA (/data-access) -- enterprises/researchers wanting
/// to license the collected voice/dialect dataset, not trainers. No
/// self-serve subscription flow yet; this just captures interest for
/// manual follow-up (MailService notifies an admin address on submit).
model DataAccessLead {
  id                String    @id @default(uuid())
  firstName         String
  lastName          String
  name              String // retained for the pre-firstName/lastName rows; new writes set it to "firstName lastName"
  email             String
  organization      String?
  website           String?
  contactedAt       DateTime?
  contactNote       String?
  contactedByUserId String?
  contactedBy       User?     @relation("DataAccessLeadContactedBy", fields: [contactedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())

  interests             DataAccessLeadInterest[]
  invitedOrganizationId String?                  @unique // set once an admin approves the lead and provisions a SubscriberOrganization + invite from it
  invitedOrganization   SubscriberOrganization?  @relation(fields: [invitedOrganizationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([email])
  @@index([contactedAt])
  @@index([contactedByUserId])
  @@map("data_access_leads")
}

/// One row per (lead, country) pair the requester checked, with the
/// dialects/subdialects checked under that country -- mirrors the
/// hierarchical picker's shape (check country -> its dialects show -> check
/// dialect -> its subdialects show -> check them). dialectTags/
/// subdialectTags are stored as tag arrays rather than a normalized junction
/// down to Dialect/DialectVariant rows, since this is a point-in-time
/// snapshot of interest for manual admin review, not a live-updating
/// selection that needs to track renames/deletions of the underlying
/// Dialect/DialectVariant catalogue.
model DataAccessLeadInterest {
  id             String         @id @default(uuid())
  leadId         String
  lead           DataAccessLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  countryId      String
  country        Country        @relation(fields: [countryId], references: [id], onDelete: Cascade)
  dialectTags    String[] // Dialect.tag values checked under this country
  subdialectTags String[] // DialectVariant.tag values checked under any of the above dialects

  @@unique([leadId, countryId])
  @@index([leadId])
  @@map("data_access_lead_interests")
}

/// One row per Contact Us form submission (/contact-us) -- general support
/// requests, not the data-buyer intent captured by DataAccessLead above.
/// MailService.sendSupportRequestNotification actually notifies an admin
/// address on submit (see PlatformSettingsService.getLeadsNotificationAddress).
model SupportRequest {
  id                String    @id @default(uuid())
  name              String
  email             String
  subject           String
  message           String
  resolvedAt        DateTime?
  resolutionNote    String?
  resolvedByUserId  String?
  resolvedBy        User?     @relation("SupportRequestResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())

  @@index([createdAt])
  @@index([email])
  @@index([resolvedAt])
  @@index([resolvedByUserId])
  @@map("support_requests")
}

/// Editor.js-backed editorial content. `excerpt` is derived by BlogService
/// from the first non-empty paragraph and is the canonical SEO description.
model BlogPost {
  id            String         @id @default(uuid())
  slug          String         @unique // always `${slugified title}-${id}`; regenerated on title change
  title         String
  content       Json
  excerpt       String
  coverImageUrl String?
  coverImageKey String?
  coverImageAlt String?
  status        BlogPostStatus @default(DRAFT)
  sortOrder     Int            @default(0)
  authorId      String
  author        User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, sortOrder])
  @@index([publishedAt])
  @@map("blog_posts")
}

enum CourseVisibility {
  PUBLIC // no login required -- study route is the public /learn/{slug}/view viewer, progress is never tracked (no CourseProgress row, since there's no authenticated user to attach one to)
  PRIVATE // default -- study route is the protected /dashboard/learn/{slug} viewer, requires login, tracks CourseProgress per trainer
}

/// Slide-deck learning content for the public Learning Center catalog.
/// `slides` is a raw JSON array of { imageUrl?, imageAlt?, text, audioUrl? }
/// (see CoursesModule's course-content.util.ts for validation) -- simpler
/// than BlogPost.content's Editor.js blocks since a slide has one fixed
/// shape, not a polymorphic block type. Reuses BlogPostStatus rather than a
/// duplicate enum since the draft/published semantics are identical.
model Course {
  id                     String           @id @default(uuid())
  slug                   String           @unique // always `${slugified title}-${id}`; regenerated on title change, same as BlogPost.slug
  title                  String
  summary                String // admin-typed short description for catalog cards -- no paragraph to derive it from like BlogPost.excerpt
  coverImageUrl          String?
  coverImageKey          String?
  coverImageAlt          String?
  slides                 Json
  status                 BlogPostStatus   @default(DRAFT)
  visibility             CourseVisibility @default(PRIVATE) // PUBLIC courses skip the login wall entirely -- see CourseVisibility doc comment
  required               Boolean          @default(false) // when true (and PUBLISHED), every trainer must complete this course (CourseProgress.completedAt set) before starting a word-training session -- see CoursesService.getIncompleteRequiredCourses and its call site in WordsService.startSession
  completionRewardTokens Decimal?         @db.Decimal(20, 8) // one-time DL credited on first completion; null/0 means no reward -- see CoursesService.saveProgress's COURSE_COMPLETION_REWARD credit
  sortOrder              Int              @default(0)
  authorId               String
  author                 User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  publishedAt            DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  progress               CourseProgress[]

  @@index([status, sortOrder])
  @@index([status, required])
  @@map("courses")
}

/// One row per (trainer, course) -- tracks how far a trainer has read into a
/// course so the slide viewer can resume where they left off.
/// completedAt is set once lastSlideIndex reaches the course's final slide.
model CourseProgress {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lastSlideIndex Int       @default(0)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@map("course_progress")
}

// ============================================================================
// Dialect Library Voice Stream -- Phase 1 (Subscriber Foundation)
//
// A separate commercial product/tenant boundary from the trainer-facing
// platform above: AI/ASR/research companies subscribe (monthly, via Stripe),
// search & preview the voice-recording catalogue (read-only against
// WordRecording), and curate selections into private Stream Decks. See
// docs/Dialect_Library_Voice_Stream_ISVP_ISVC_Plan.md for the full product
// plan; only Phase 1 (no ISVP/ISVC validation, no streaming API/keys yet)
// is modeled here. Deliberately isolated from Role/User/RefreshToken/OtpCode
// -- subscriber auth is a fully separate tenant/security boundary.
// ============================================================================

enum SubscriberOrgRole {
  OWNER
  ADMIN
  DATASET_MANAGER
  VALIDATOR // reserved, no-op until Phase 2 (ISVP) -- avoids a membership-role migration later
  API_DEVELOPER // reserved, no-op until Phase 3 (Stream Keys)
  BILLING_MANAGER
  AUDITOR
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELED
}

model SubscriberOrganization {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique // DLORG-style external id, generated at creation
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())

  memberships            SubscriberMembership[]
  invites                SubscriberInvite[]
  subscription           Subscription?
  streamDecks            StreamDeck[]
  validations            SubscriberValidation[]
  organizationConsensus  OrganizationValidationConsensus[]
  streamApiKeys          StreamApiKey[]
  webhookSubscriptions   WebhookSubscription[]
  oauthClients           OAuthClient[]
  ssoIdpConfig           SsoIdpConfig? // Phase 4 SSO -- present only for orgs with SAML configured
  securityPolicy         SubscriberOrgSecurityPolicy? // Phase 4 enterprise security policies -- present only for orgs with a policy configured
  activityEvents         OrgActivityEvent[]
  anomalyEvents          AnomalyEvent[]
  usageCounters          UsageCounter[]
  sourceDataAccessLead   DataAccessLead?
  deckLicenseAcceptances DeckLicenseAcceptance[]
  validationQueueItems   ValidationQueueItem[]

  @@map("subscriber_organizations")
}

model SubscriberUser {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String? // nullable for SSO-only, JIT-provisioned users (see SsoService.handleAssertion) -- every password-login code path must null-check before bcrypt.compare
  firstName       String
  lastName        String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  memberships         SubscriberMembership[]
  refreshTokens       SubscriberRefreshToken[]
  otpCodes            SubscriberOtpCode[]
  validations         SubscriberValidation[]
  ssoIdentities       SsoIdentity[]
  passwordResetTokens SubscriberPasswordResetToken[]

  @@map("subscriber_users")
}

model SubscriberMembership {
  id             String                 @id @default(uuid())
  userId         String
  user           SubscriberUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   SubscriberOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           SubscriberOrgRole
  invitedAt      DateTime               @default(now())
  acceptedAt     DateTime?

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("subscriber_memberships")
}

/// A pending invitation to join a SubscriberOrganization, before the
/// invitee has a SubscriberUser account. SubscriberMembership.userId is a
/// hard FK (a membership always belongs to an existing user), so an invite
/// to a not-yet-registered email needs its own row -- accepting the invite
/// (AcceptSubscriberInviteDto) creates the SubscriberUser + SubscriberMembership
/// together and marks this row consumed, mirroring the opaque-token pattern
/// in auth/token.util.ts (raw token returned once, only its hash stored).
model SubscriberInvite {
  id              String                 @id @default(uuid())
  organizationId  String
  organization    SubscriberOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email           String
  firstName       String? // set on org-provisioning invites (admin-approved DataAccessLead) so acceptInvite can name the new SubscriberUser correctly instead of guessing from the email; null on ordinary member invites, where the invitee already has a name on file if they already exist
  lastName        String?
  role            SubscriberOrgRole
  tokenHash       String                 @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime               @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("subscriber_invites")
}

/// Own table rather than a reuse of OtpCode -- OtpCode.userId is a hard FK to
/// User (the trainer table), which SubscriberUser cannot satisfy. Same
/// generate/hash/TTL/attempts/consume-once shape as OtpCode; purpose reuses
/// the existing OtpPurpose enum only so MailService.sendOtpEmail's copy
/// lookup (otpCopyForPurpose) can be shared -- no FK relationship implied.
model SubscriberOtpCode {
  id          String         @id @default(uuid())
  userId      String
  user        SubscriberUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     OtpPurpose // SUBSCRIBER_EMAIL_VERIFY | SUBSCRIBER_LOGIN only
  codeHash    String
  ticketHash  String?        @unique
  attempts    Int            @default(0)
  maxAttempts Int            @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime       @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("subscriber_otp_codes")
}

/// Mirrors PasswordResetToken -- can't reuse it directly since its userId is
/// a hard FK to the trainer User table (same reason SubscriberOtpCode above
/// is its own table rather than reusing OtpCode).
model SubscriberPasswordResetToken {
  id        String         @id @default(uuid())
  userId    String
  user      SubscriberUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId])
  @@map("subscriber_password_reset_tokens")
}

/// Opaque refresh tokens, same rotation-on-use + family-revocation-on-reuse
/// shape as RefreshToken (see auth.service.ts:530-583) -- separate table
/// since it FKs to SubscriberUser, not User.
model SubscriberRefreshToken {
  id         String         @id @default(uuid())
  userId     String
  user       SubscriberUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String         @unique
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime       @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("subscriber_refresh_tokens")
}

model SubscriptionPlan {
  id                                String          @id @default(uuid())
  key                               String          @unique // "starter" | "professional" | "enterprise"
  name                              String
  // Free plans never go through Stripe Checkout and therefore have no Price.
  stripePriceId                     String?         @unique
  monthlyUsdAmount                  Decimal         @db.Decimal(10, 2)
  maxStreamDecks                    Int? // null = unlimited
  maxTeamMembers                    Int?
  maxConcurrentStreams              Int? // Phase 3 -- null = unlimited, enforced by ConcurrentStreamGuard
  rateLimitPerMinute                Int? // Phase 3 -- null = unlimited, enforced by StreamKeyRateLimitGuard
  minIsvcConfidence                 IsvcConfidence? // Phase 5 -- null = full catalogue access, enforced by TierGateGuard
  monthlyByteQuota                  BigInt? // Phase 4b -- null = unlimited, enforced by QuotaGuard against UsageCounter
  monthlyRequestQuota               Int? // Phase 4b -- null = unlimited, enforced by QuotaGuard against UsageCounter
  ssoEnabled                        Boolean         @default(false) // Phase 4 -- enterprise-tier gate, enforced by SsoEntitlementGuard
  enterpriseSecurityPoliciesEnabled Boolean         @default(false) // Phase 4 -- enterprise-tier gate, enforced by SecurityPolicyEntitlementGuard
  reservedCapacityPercent           Int? // Phase 4 -- null = no reserved floor (Starter/Professional default); Enterprise orgs get this % of FLEET_MAX_CONCURRENT_STREAMS/FLEET_MAX_REQUESTS_PER_MINUTE protected from non-Enterprise admission, enforced by DedicatedCapacityGuard
  features                          String[]        @default([]) // admin-authored comparison bullets, display-only -- not enforced by any guard, unlike the numeric limits above
  active                            Boolean         @default(true)

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                   String                 @id @default(uuid())
  organizationId       String                 @unique
  organization         SubscriberOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId               String
  plan                 SubscriptionPlan       @relation(fields: [planId], references: [id])
  status               SubscriptionStatus     @default(TRIAL)
  stripeSubscriptionId String?                @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@map("subscriptions")
}

/// Idempotency ledger for Stripe webhook delivery -- id is Stripe's own
/// event.id (simpler than NOWPayments' computed-hash approach in
/// wallet.controller.ts since Stripe already guarantees a stable event id).
/// processedAt null means "seen but not yet successfully handled" -- a
/// retry after a transient failure re-attempts processing on the same row.
model StripeWebhookEvent {
  id          String    @id // Stripe event.id, not a generated uuid
  type        String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("stripe_webhook_events")
}

enum StreamDeckType {
  MANUAL
  SMART
}

enum StreamDeckVisibility {
  PRIVATE
  PUBLIC
}

model StreamDeck {
  id              String                 @id @default(uuid())
  deckKey         String                 @unique // "DLSD-{country}-{dialect}-{subdialect}-{6 chars}" per the product plan section 9.2
  organizationId  String
  organization    SubscriberOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  type            StreamDeckType         @default(MANUAL)
  createdByUserId String
  createdAt       DateTime               @default(now())

  // Phase 5 "high-confidence dataset packages" (doc section 62) -- a public
  // deck is discoverable and browsable by OTHER organizations, but NEVER
  // streamable by them: manifest/audio access stays scoped to
  // organizationId exactly as before, unchanged. A foreign org may only
  // copy a public deck's recordings into a new deck of their own, or queue
  // them for their own validators (see ValidationQueueItem below) --
  // never call the deck's own manifest/audio endpoints directly. Reverting
  // PUBLIC -> PRIVATE does not retract copies/queue-imports already made.
  visibility StreamDeckVisibility @default(PRIVATE)

  items          StreamDeckItem[]
  streamApiKeys  StreamApiKey[]
  rule           StreamDeckRule?
  versions       StreamDeckVersion[]
  currentVersion StreamDeckCurrentVersion?
  license        DeckLicense?

  @@index([organizationId])
  @@index([visibility])
  @@map("stream_decks")
}

/// Terms a browsing (non-owning) org must accept before copying from or
/// queuing validation on a PUBLIC deck -- doc section 62's "commercial
/// licensing automation," scoped to acceptance tracking only (no payment
/// flow: access is already gated by each org's own subscription). Only
/// meaningful while the deck is PUBLIC; optional even then -- a public
/// deck with no DeckLicense row requires no acceptance step.
model DeckLicense {
  id                    String     @id @default(uuid())
  deckId                String     @unique
  deck                  StreamDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  termsSummary          String // shown to the browsing org before they accept
  attributionRequired   Boolean    @default(false)
  redistributionAllowed Boolean    @default(false)
  createdByUserId       String
  updatedAt             DateTime   @updatedAt
  createdAt             DateTime   @default(now())

  acceptances DeckLicenseAcceptance[]

  @@map("deck_licenses")
}

/// One row per (browsing organization, license) -- the license's own
/// updatedAt is NOT compared against this on every check (re-accepting on
/// every terms edit would break already-copied data for no benefit);
/// acceptance is a one-time gate, same posture as the acceptance itself
/// being a compliance record, not a live permission check.
model DeckLicenseAcceptance {
  id               String                 @id @default(uuid())
  licenseId        String
  license          DeckLicense            @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     SubscriberOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  acceptedByUserId String
  acceptedAt       DateTime               @default(now())

  @@unique([licenseId, organizationId])
  @@map("deck_license_acceptances")
}

/// A recordingId a browsing org queued from someone else's PUBLIC deck for
/// its OWN validators to pick up and score -- deliberately NOT a
/// SubscriberValidation row (no scores exist yet at import time).
/// SubmitValidationDto submission later against the same recordingId is
/// unrelated at the schema level; this table is only a shortlist/to-do
/// surface, matching the "add to validation list" access this org
/// requested (not any change to ISVP submission itself).
model ValidationQueueItem {
  id             String                 @id @default(uuid())
  organizationId String
  organization   SubscriberOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recordingId    String
  sourceDeckId   String? // the PUBLIC deck this was queued from, if any -- no FK, deck may later go private/be deleted without breaking this record
  addedByUserId  String
  addedAt        DateTime               @default(now())

  @@unique([organizationId, recordingId])
  @@index([organizationId])
  @@map("validation_queue_items")
}

model StreamDeckItem {
  id            String     @id @default(uuid())
  deckId        String
  deck          StreamDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  recordingId   String // WordRecording.id -- no FK by design: keeps the Voice Stream domain
  // loosely coupled to the trainer-facing schema, and a WordRecording can
  // be legitimately purged (audio retention) without needing deck cleanup logic
  addedByUserId String
  addedAt       DateTime   @default(now())

  @@unique([deckId, recordingId])
  @@index([deckId])
  @@map("stream_deck_items")
}

// ============================================================================
// Dialect Library Voice Stream -- Phase 4a (Deck Versioning & Curation)
//
// Stream Deck versions, snapshots, Smart Decks with saved rules, and the
// change feed -- see docs/Dialect_Library_Voice_Stream_ISVP_ISVC_Plan.md
// sections 9-12 and 31. Every training job can reference DLSD-...@42 and
// get the exact same dataset every time.
// ============================================================================

/// Saved Smart Deck rule (doc section 9.3) -- one row per deck, only present
/// when StreamDeck.type = SMART. Mirrors SearchCatalogueDto's field set,
/// extended with the 3 fields that DTO doesn't cover yet (subdialect,
/// minOrganizationCount, minAudioQuality) per doc 9.3's example rule.
model StreamDeckRule {
  id                   String          @id @default(uuid())
  deckId               String          @unique
  deck                 StreamDeck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  countryCode          String?
  dialectTag           String?
  subdialectTag        String?
  minScore             Int?
  minIsvs              Int?
  minConfidence        IsvcConfidence?
  minOrganizationCount Int?
  minAudioQuality      Int?
  updatedAt            DateTime        @updatedAt

  @@map("stream_deck_rules")
}

/// Append-only version snapshot -- one row per (deckId, version). Created
/// only when membership/metadata actually changed (materiality check,
/// mirrors IsvcAggregation's writeNewVersionIfMaterial pattern in
/// services/isvc-scorer). itemCount is denormalized for cheap listing; the
/// actual frozen membership lives in StreamDeckVersionItem.
model StreamDeckVersion {
  id            String     @id @default(uuid())
  deckId        String
  deck          StreamDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  version       Int
  itemCount     Int
  createdAt     DateTime   @default(now())
  createdReason String // "manual_add" | "manual_remove" | "smart_rule_match" | "eligibility_purge"

  items   StreamDeckVersionItem[]
  current StreamDeckCurrentVersion?

  @@unique([deckId, version])
  @@index([deckId])
  @@map("stream_deck_versions")
}

/// Frozen per-recording membership + metadata for one StreamDeckVersion --
/// doc section 12's snapshot requirement ("preserve recording membership,
/// metadata references, DL Canonical Scores at snapshot time, ISVC version
/// references"). Denormalizes the fields the manifest actually returns so
/// a pinned-version manifest never has to re-derive historical scores from
/// current (possibly since-changed) WordRecording/IsvcAggregation rows.
model StreamDeckVersionItem {
  id               String            @id @default(uuid())
  deckVersionId    String
  deckVersion      StreamDeckVersion @relation(fields: [deckVersionId], references: [id], onDelete: Cascade)
  recordingId      String
  durationMs       Int?
  dialectTag       String
  subdialectTag    String?
  dlCanonicalScore Decimal?          @db.Decimal(5, 2)
  isvs             Decimal?          @db.Decimal(5, 2)
  isvcVersion      Int?

  @@unique([deckVersionId, recordingId])
  @@index([deckVersionId])
  @@map("stream_deck_version_items")
}

/// Points at the current StreamDeckVersion per deck -- same "materialized
/// pointer" shape as IsvcCurrent, avoids a MAX(version) subquery on every
/// manifest read.
model StreamDeckCurrentVersion {
  deckId    String            @id
  deck      StreamDeck        @relation(fields: [deckId], references: [id], onDelete: Cascade)
  versionId String            @unique
  version   StreamDeckVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("stream_deck_current_versions")
}

/// Lightweight preview-access record (Phase 1 only) -- full stream-request
/// audit logging (doc section 37: bytes streamed, result code, entitlement
/// decision, etc.) is a Phase 3 concern once the actual streaming API exists.
model CataloguePreviewLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  recordingId    String
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("catalogue_preview_logs")
}

// ============================================================================
// Dialect Library Voice Stream -- Phase 2 (ISVP / ISVS / ISVC)
//
// Independent Subscriber Validation Programme: subscriber organizations
// submit standardized quality validations on catalogue recordings;
// services/isvc-scorer (a separate consumer service, same async-job
// pattern as consensus-scorer) aggregates them into a versioned ISVC
// consensus with an ISVS score, confidence level, and agreement
// percentage, surfaced back into catalogue search as a filter dimension.
// See docs/Dialect_Library_Voice_Stream_ISVP_ISVC_Plan.md sections 13-22.
// ============================================================================

enum IsvcConfidence {
  EMERGING
  ESTABLISHED
  HIGH
  VERY_HIGH
}

/// Org-internal peer review state for a SubscriberValidation -- gates
/// whether it counts toward ISVC aggregation (product plan section 59's
/// "validation queues" / "approve/reject" bullets). Reviewed by someone
/// in the SAME org as the submitter (OWNER/ADMIN/DATASET_MANAGER), never
/// by Dialect Library platform staff -- this is peer review, not platform
/// moderation.
enum ValidationReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One subscriber organization's validation of one WordRecording, submitted
/// by one validator (userId) on behalf of their org. A single org may have
/// multiple validators submit for the same recording --
/// OrganizationValidationConsensus (below) normalizes these down to one
/// score per org before ISVC aggregation, per the product plan section 18
/// ("one company with 50 validators must not have 50 times the influence
/// of one company with one validator").
model SubscriberValidation {
  id                    String                 @id @default(uuid())
  organizationId        String
  organization          SubscriberOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                String
  user                  SubscriberUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordingId           String // WordRecording.id -- no FK, same loose-coupling rationale as StreamDeckItem.recordingId
  transcriptAccuracy    Int // 0-100, each dimension from the product plan section 14
  pronunciationAccuracy Int
  dialectAuthenticity   Int
  speechClarity         Int
  audioQuality          Int
  overallScore          Int // the validator's own rollup; NOT re-derived from the dimensions above (validator's holistic judgment, dimensions are supporting detail)
  notes                 String? // private to the org, never surfaced in ISVC aggregates (product plan section 23)
  status                ValidationReviewStatus @default(PENDING) // only APPROVED rows feed OrganizationValidationConsensus -- see isvc-scorer's refreshOrgConsensus
  reviewedByUserId      String? // SubscriberUser.id of the org peer who approved/rejected -- no FK, same loose-coupling shape as recordingId (reviewer may leave the org later without breaking history)
  reviewedAt            DateTime?
  rejectionReason       String? // required on reject, shown back to the submitter; cleared on a fresh resubmission
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  auditLogs ValidationAuditLog[]

  @@unique([organizationId, userId, recordingId]) // one active validation per validator per recording; resubmission overwrites via upsert
  @@index([recordingId])
  @@index([organizationId, recordingId])
  @@index([organizationId, status])
  @@map("subscriber_validations")
}

enum ValidationAuditAction {
  SUBMITTED
  RESUBMITTED
  APPROVED
  REJECTED
}

/// Append-only audit trail of every SubscriberValidation state transition
/// (product plan section 59's "validation audit logs" bullet) -- never
/// updated or deleted, unlike SubscriberValidation itself which is
/// mutated in place on resubmission/review.
model ValidationAuditLog {
  id           String                @id @default(uuid())
  validationId String
  validation   SubscriberValidation  @relation(fields: [validationId], references: [id], onDelete: Cascade)
  action       ValidationAuditAction
  actorUserId  String // the SubscriberUser who performed the action (submitter for SUBMITTED/RESUBMITTED, reviewer for APPROVED/REJECTED)
  reason       String? // rejection reason, when action = REJECTED
  createdAt    DateTime              @default(now())

  @@index([validationId, createdAt])
  @@map("validation_audit_logs")
}

/// One row per (organization, recording) -- the org-normalized score
/// consumed by ISVC aggregation. Recalculated by isvc-scorer whenever any
/// SubscriberValidation in the org changes; ISVC then aggregates across
/// these rows, never across raw SubscriberValidation rows directly.
model OrganizationValidationConsensus {
  id             String                 @id @default(uuid())
  organizationId String
  organization   SubscriberOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recordingId    String
  validatorCount Int // how many of this org's validators contributed
  meanScore      Decimal                @db.Decimal(5, 2) // mean of this org's validators' overallScore
  updatedAt      DateTime               @updatedAt

  @@unique([organizationId, recordingId])
  @@index([recordingId])
  @@index([organizationId, updatedAt])
  @@map("organization_validation_consensus")
}

/// Versioned ISVC snapshot for one recording -- append-only (never updated
/// in place) so historical states remain queryable (product plan section
/// 21: "Subscribers should be able to identify the exact validation state
/// used during model training"). Only the highest `version` per
/// recordingId is "current" -- IsvcCurrent (below) points at it for O(1)
/// catalogue-search joins instead of a MAX(version) subquery on every
/// search.
model IsvcAggregation {
  id                String         @id @default(uuid())
  recordingId       String
  version           Int
  isvs              Decimal        @db.Decimal(5, 2) // the ISVS itself
  agreement         Decimal        @db.Decimal(5, 2) // 0-100
  confidence        IsvcConfidence
  organizationCount Int
  outlierOrgCount   Int
  createdAt         DateTime       @default(now())

  current IsvcCurrent?

  @@unique([recordingId, version])
  @@index([recordingId])
  @@map("isvc_aggregations")
}

/// Points at the current IsvcAggregation version per recording -- avoids a
/// MAX(version) correlated subquery in CatalogueService.search's ISVC
/// filter, same "materialized pointer" shape IsvcAggregation's own doc
/// comment above describes.
model IsvcCurrent {
  recordingId   String          @id
  aggregationId String          @unique
  aggregation   IsvcAggregation @relation(fields: [aggregationId], references: [id], onDelete: Cascade)

  @@map("isvc_current")
}

// ============================================================================
// Dialect Library Voice Stream -- Phase 3 (Voice Stream API)
//
// Turns Voice Stream from "browse in a dashboard" into "pull data into an
// external pipeline": subscriber organizations mint Stream Keys (deck-scoped
// or org-wide) and external/programmatic clients use those keys -- not the
// human SubscriberAccessTokenClaims JWT -- to enumerate a Stream Deck
// (manifest), fetch a recording's metadata, and stream its audio with HTTP
// Range support. See docs/Dialect_Library_Voice_Stream_ISVP_ISVC_Plan.md
// sections 25-38. Python SDK (section 32) and deck versioning/change-feed
// (section 31, Phase 4) are explicitly out of scope here.
// ============================================================================

enum StreamKeyScope {
  DECK_READ
  DECK_LIST
  AUDIO_STREAM
  METADATA_READ
  MANIFEST_READ
  USAGE_READ
}

/// A Stream Key is either deck-scoped (deckId set -- doc section 26.1) or
/// org-wide (deckId null -- section 26.2, "all authorized Stream Decks
/// within the org", never the whole platform). Bearer credential for
/// machine/SDK clients hitting /stream/v1/*, distinct from the human
/// dashboard JWT. Hashed per auth/token.util.ts's
/// generateOpaqueToken/hashToken convention -- the full key (prefixed
/// "dlsk_live_...") is shown exactly once at creation/rotation and never
/// stored or returned again; only keyHash + keyPrefix (display-only, a la
/// ApiAccessToken.lastFour) persist.
model StreamApiKey {
  id              String                 @id @default(uuid())
  organizationId  String
  organization    SubscriberOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deckId          String? // null = org-wide key (section 26.2)
  deck            StreamDeck?            @relation(fields: [deckId], references: [id], onDelete: Cascade)
  keyHash         String                 @unique
  keyPrefix       String // display-only, e.g. "dlsk_live_7MqP"
  scopes          StreamKeyScope[]
  allowedIps      String[]               @default([]) // empty = no IP restriction
  createdByUserId String
  createdAt       DateTime               @default(now())
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?

  @@index([organizationId])
  @@index([deckId])
  @@map("stream_api_keys")
}

/// Phase 4b (OAuth M2M) -- a second, coexisting machine-credential type
/// alongside StreamApiKey, for integrators who want standard OAuth2
/// client_credentials tooling. clientId is safe to display in full (not a
/// secret, mirrors StreamApiKey.keyPrefix's display-only role); secretHash
/// follows the same one-way-hash convention as StreamApiKey.keyHash (the
/// client presents its secret back at the token endpoint, the server never
/// needs to read it back -- same shape as Stream Keys, unlike webhook
/// signing secrets which the server itself must read back to sign
/// outbound payloads). Exchanged for a short-lived JWT
/// (oauth-m2m-jwt.util.ts) that downstream guards verify statelessly (no
/// DB hit per request) -- the actual value-add over a Stream Key, traded
/// against instant revocability, which is why the token TTL is kept short.
model OAuthClient {
  id              String                 @id @default(uuid())
  organizationId  String
  organization    SubscriberOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deckId          String? // same org-wide-vs-deck-scoped shape as StreamApiKey.deckId
  clientId        String                 @unique
  secretHash      String
  scopes          StreamKeyScope[] // reuses the existing scope enum -- same permission model as Stream Keys
  createdByUserId String
  createdAt       DateTime               @default(now())
  revokedAt       DateTime?

  @@index([organizationId])
  @@map("oauth_clients")
}

// ============================================================================
// Dialect Library Voice Stream -- Phase 4 (SAML 2.0 SSO, enterprise tier).
// See docs/Dialect_Library_Voice_Stream_ISVP_ISVC_Plan.md enterprise-tier
// "SSO/SAML" bullet. Backend Service Provider (SP) only -- no subscriber
// dashboard exists yet, so IdP-initiated login is the only fully working
// entry point; SP-initiated login is a real, working endpoint that nothing
// calls yet (see SsoAcsController login-redirect route).
// ============================================================================

/// Per-organization Identity Provider configuration. One row per org
/// (organizationId is unique -- multi-IdP-per-org is a future concern, not
/// built here). X.509 certs are public material (not secrets), stored as
/// plaintext -- unlike WebhookSubscription.encryptedSecret, no AES-256-GCM
/// wrapping is needed or appropriate here.
model SsoIdpConfig {
  id             String                 @id @default(uuid())
  organizationId String                 @unique
  organization   SubscriberOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  idpEntityId    String
  idpSsoUrl      String
  idpCertificate String

  spEntityId String

  nameIdFormat       String @default("urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress")
  emailAttribute     String @default("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")
  firstNameAttribute String @default("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/givenname")
  lastNameAttribute  String @default("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/surname")

  defaultRole SubscriberOrgRole @default(VALIDATOR)

  active          Boolean  @default(true)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  identities SsoIdentity[]

  @@map("sso_idp_configs")
}

/// Backs SsoService's PrismaSamlCacheProvider, a node-saml CacheProvider
/// implementation (saveAsync/getAsync/removeAsync over {key, value,
/// createdAt}) -- node-saml's own AuthnRequest-ID tracking for SP-initiated
/// login's InResponseTo replay/CSRF defense. node-saml's built-in
/// InMemoryCacheProvider explicitly documents itself as "NOT sufficient"
/// for load-balanced/multi-instance deployments since a request generated
/// on one instance may be validated on another -- this table is that
/// caller-supplied, horizontally-scalable replacement. IdP-initiated
/// assertions have no InResponseTo and never touch this table. Rows are
/// single-use: node-saml calls removeAsync on successful validation.
model SsoRequestCache {
  key       String   @id
  value     String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("sso_request_cache")
}

/// Links a SubscriberUser to the (idpConfig, NameID) pair the IdP asserts
/// for them -- mirrors LinkedAccount's shape (provider + providerAccountId)
/// rather than extending SubscriberUser directly, so a user can in principle
/// have both a password and an SSO link and so this table, not
/// SubscriberUser, carries the SSO-specific provenance (lastLoginAt, which
/// IdP). One row per (idpConfigId, user).
model SsoIdentity {
  id           String         @id @default(uuid())
  userId       String
  user         SubscriberUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  idpConfigId  String
  idpConfig    SsoIdpConfig   @relation(fields: [idpConfigId], references: [id], onDelete: Cascade)
  nameId       String
  firstLoginAt DateTime       @default(now())
  lastLoginAt  DateTime       @default(now())

  @@unique([idpConfigId, nameId])
  @@unique([idpConfigId, userId])
  @@map("sso_identities")
}

/// Phase 4 "enterprise security policies" -- per-org toggles an OWNER/ADMIN
/// can configure to enforce rules on their own org's members. One row per
/// org (organizationId unique), mirroring SsoIdpConfig's 1:1-optional shape.
model SubscriberOrgSecurityPolicy {
  id             String                 @id @default(uuid())
  organizationId String                 @unique
  organization   SubscriberOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  requireSso               Boolean             @default(false) // blocks password login for every role except OWNER when true -- see SubscriberAuthService.login
  refreshTokenTtlMinutes   Int? // null = platform default (30 days); overrides REFRESH_TOKEN_TTL_MS per-org
  minRoleForApiKeyCreation SubscriberOrgRole[] @default([]) // empty = platform default (StreamKeysController.CAN_MANAGE_KEYS); non-empty = exact allowed-role set for key creation in this org. SubscriberOrgRole has no inherent ordering, so this is an explicit set, not a hierarchy floor.
  requireIpAllowlist       Boolean             @default(false) // when true, StreamKeysService.create/rotate reject an empty allowedIps

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("subscriber_org_security_policies")
}

/// Append-only audit/usage record, one row per stream-API request (manifest,
/// metadata, or audio) -- per doc section 37 ("every stream should record
/// ... bytes streamed, result code, entitlement decision") and section 36
/// (usage metering). Not an extension of CataloguePreviewLog: that table is
/// human-dashboard/userId-keyed (Phase 1 preview clicks); this is
/// StreamApiKey-keyed machine traffic, no human user necessarily present.
model StreamAccessLog {
  id                  String   @id @default(uuid())
  // Loose reference, not a Prisma relation -- Phase 4b's OAuth M2M clients
  // authenticate the same /stream/v1/* routes and populate this same field
  // with an OAuthClient.id, so a hard FK to StreamApiKey alone would reject
  // every OAuth-authenticated request's audit log write. credentialType
  // disambiguates which table this id actually points into (same
  // loose-coupling rationale already used for deckId/recordingId above).
  streamApiKeyId      String
  credentialType      String   @default("stream_key") // "stream_key" | "oauth_client"
  organizationId      String
  deckId              String?
  recordingId         String?
  requestType         String // "manifest" | "metadata" | "audio" | "usage"
  requestedRange      String? // raw Range header, audio requests only
  bytesStreamed       BigInt? // audio requests only
  durationStreamedMs  Int? // audio requests only, the recording's full durationMs at request time (WordRecording.durationMs) -- coarse "hours streamed" usage signal, not scaled by partial-range bytes actually sent
  resultCode          Int // HTTP status actually returned
  entitlementDecision String // "allowed" | "denied:<reason>"
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime @default(now())

  @@index([streamApiKeyId, createdAt])
  @@index([organizationId, createdAt])
  @@map("stream_access_logs")
}

// ============================================================================
// Dialect Library Voice Stream -- Phase 4b (Webhooks)
//
// Subscriber-configured HTTP callbacks for Voice Stream domain events (doc
// section 51's event catalogue). Delivery retry is handled by Redis
// Streams' own consumer-group reclaim loop (see RedisStreamsService) --
// no separate backoff mechanism needed, same pattern isvc-jobs/
// smart-deck-jobs already use.
// ============================================================================

enum WebhookEventType {
  SUBSCRIBER_CREATED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_PAYMENT_FAILED
  DECK_CREATED
  DECK_ITEM_ADDED
  DECK_ITEM_REMOVED
  DECK_VERSION_CREATED
  VALIDATION_SUBMITTED
  ISVC_VERSION_CREATED
  API_KEY_CREATED
  API_KEY_REVOKED
  AUDIO_STREAM_COMPLETED
  AUDIO_STREAM_DENIED
  ANOMALY_DETECTED
}

/// A subscriber-configured HTTP callback endpoint. One organization may
/// have several, each independently subscribed to a subset of event types.
/// Signing secret is reversibly encrypted (common/token-crypto.util.ts's
/// AES-256-GCM shape, same as ApiAccessToken) -- the server must read it
/// back on every delivery to compute the outbound HMAC, unlike a Stream
/// Key which is only ever hash-compared (auth/token.util.ts).
model WebhookSubscription {
  id              String                 @id @default(uuid())
  organizationId  String
  organization    SubscriberOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url             String
  eventTypes      WebhookEventType[]
  encryptedSecret String // AES-256-GCM ciphertext, base64
  secretIv        String
  secretAuthTag   String
  active          Boolean                @default(true)
  createdByUserId String
  createdAt       DateTime               @default(now())

  deliveries WebhookDeliveryLog[]

  @@index([organizationId])
  @@map("webhook_subscriptions")
}

/// Append-only delivery attempt record -- one row per actual HTTP delivery
/// attempt (not per event; a retried delivery gets its own row).
/// resultCode is null when the request itself failed to complete
/// (DNS/timeout/connection refused).
model WebhookDeliveryLog {
  id             String              @id @default(uuid())
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventType      WebhookEventType
  payload        Json
  attemptNumber  Int
  resultCode     Int?
  succeeded      Boolean
  errorMessage   String?
  createdAt      DateTime            @default(now())

  @@index([subscriptionId, createdAt])
  @@map("webhook_delivery_logs")
}

// ============================================================================
// Dialect Library Voice Stream -- Phase 4b (Audit exports, Anomaly
// detection, Quota policies, remainder). See docs/Dialect_Library_Voice_Stream_ISVP_ISVC_Plan.md
// section 61.
// ============================================================================

enum ActivityEventType {
  KEY_CREATED
  KEY_ROTATED
  KEY_REVOKED
  OAUTH_CLIENT_CREATED
  OAUTH_CLIENT_REVOKED
  MEMBER_INVITED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  SUBSCRIPTION_PLAN_CHANGED
  DECK_CREATED
  DECK_RENAMED
  DECK_DELETED
  DECK_ITEM_ADDED
  DECK_ITEM_REMOVED
  DECK_VISIBILITY_CHANGED
  SSO_CONFIGURED
  SSO_DISABLED
  SSO_LOGIN
  SECURITY_POLICY_UPDATED
  SECURITY_POLICY_REMOVED
}

/// Org-activity audit timeline -- who did what, when, distinct from
/// StreamAccessLog (machine-traffic requests) and WebhookDeliveryLog
/// (outbound delivery attempts). No prior audit-log model existed
/// anywhere in this codebase before this phase; actorUserId is null for
/// system-initiated events (e.g. a Stripe-webhook-driven plan change).
model OrgActivityEvent {
  id             String                 @id @default(uuid())
  organizationId String
  organization   SubscriberOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventType      ActivityEventType
  actorUserId    String?
  metadata       Json
  createdAt      DateTime               @default(now())

  @@index([organizationId, createdAt])
  @@map("org_activity_events")
}

/// One row per threshold-rule breach detected by the hourly
/// anomaly-detection cron (anomaly-detection.service.ts). Dedup key is
/// [organizationId, ruleKey, windowStart] at the application level (no
/// unique constraint -- the cron's own dedup check reads the latest event
/// per rule before writing, matching WebhookDeliveryLog's append-only,
/// no-unique-constraint shape).
model AnomalyEvent {
  id             String                 @id @default(uuid())
  organizationId String
  organization   SubscriberOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ruleKey        String // "denial_rate_spike" | "new_ip_burst" | "request_volume_spike"
  windowStart    DateTime
  windowEnd      DateTime
  details        Json
  createdAt      DateTime               @default(now())

  @@index([organizationId, createdAt])
  @@map("anomaly_events")
}

/// Accumulated monthly usage per organization, incremented at
/// StreamAccessLogService.record()'s choke point (every manifest/metadata/
/// audio/usage request). periodStart is always the first-of-month UTC
/// anchor for the billing period; QuotaGuard reads this row to enforce
/// SubscriptionPlan.monthlyByteQuota/monthlyRequestQuota before serving a
/// request (the increment here happens after serving -- enforcement and
/// accounting are deliberately separate steps, same split as
/// ConcurrentStreamGuard's acquire/release).
model UsageCounter {
  id             String                 @id @default(uuid())
  organizationId String
  organization   SubscriberOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  bytesUsed      BigInt                 @default(0)
  requestsUsed   Int                    @default(0)

  @@unique([organizationId, periodStart])
  @@map("usage_counters")
}

// ---------------------------------------------------------------------------
// Community forum (community.dialectlibrary.com) -- see docs/COMMUNITY-PLAN.md.
// Replaces an earlier self-hosted Discourse instance (retired). Authenticated
// via the SAME User/JwtAuthGuard identity as the rest of the main app -- not
// a separate identity system like SubscriberUser (Voice Stream). Every model
// here is prefixed Community* to keep it visually distinct from the
// unrelated `CommunityMember`-shaped noun collisions elsewhere in this large
// schema (there are none today, but the prefix is cheap insurance given how
// generic "Post"/"Reply"/"Tag" would otherwise read next to 150+ other models).
// ---------------------------------------------------------------------------

enum CommunityRole {
  MEMBER
  MODERATOR
  STAFF
}

enum CommunityUserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum CommunityPostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  DELETED
}

enum CommunityReplyStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

enum CommunityReactionType {
  LIKE // sole MVP value -- modeled as an enum so a second reaction type is a data change later, not a schema migration
}

enum CommunityAttachmentType {
  IMAGE
  AUDIO
  DOCUMENT
}

enum CommunityNotificationType {
  REPLY_TO_POST
  REPLY_TO_REPLY
  MENTION
  ANNOUNCEMENT
  MODERATION_ACTION
}

enum CommunityReportTargetType {
  POST
  REPLY
  PROFILE
}

enum CommunityReportReason {
  SPAM
  ABUSE_HARASSMENT
  MISINFORMATION
  OFF_TOPIC
  INAPPROPRIATE_CONTENT
  IMPERSONATION
  COPYRIGHT
  OTHER
}

enum CommunityReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum CommunityModeratorActionType {
  HIDE_POST
  RESTORE_POST
  DELETE_POST
  LOCK_THREAD
  UNLOCK_THREAD
  DELETE_REPLY
  WARN_USER
  SUSPEND_USER
  BAN_USER
  RESTORE_USER
  RESOLVE_REPORT
  DISMISS_REPORT
  PIN_POST
  UNPIN_POST
}

/// Singleton settings row for Community-wide gates, same posture as
/// PlatformSettings -- CommunitySettingsService upserts the single
/// id="default" row on read so no seed/migration data-fill is ever needed.
/// Kept separate from PlatformSettings since these gates are specific to
/// the Community feature and unrelated to the rest of the platform.
model CommunitySettings {
  id                           String   @id @default("default")
  postingEnabled               Boolean  @default(true)
  repliesEnabled               Boolean  @default(true)
  attachmentsEnabled           Boolean  @default(true)
  reactionsEnabled             Boolean  @default(true)
  newMemberPostingDelayMinutes Int      @default(0) // a member cannot post until this many minutes after their CommunityProfile was created; 0 = no delay
  requireApprovalForNewMembers Boolean  @default(false) // a simplified block-with-message posture for this pass, not a full moderation queue -- see CommunityPostsService.create
  updatedAt                    DateTime @updatedAt
  createdAt                    DateTime @default(now())

  @@map("community_settings")
}

/// Community-specific profile data layered onto the main User account by
/// userId (1:1) -- never duplicates sensitive account data (email, phone,
/// KYC, wallet, etc). displayName/country are pre-filled from User at
/// first-visit creation time but are independently editable afterward (a
/// member can present differently in Community than their account name).
/// languages/dialects are new, Community-only data -- User has a single
/// dialectId/dialectVariantId, not a list, so this is deliberately separate
/// rather than reusing that field.
model CommunityProfile {
  id            String              @id @default(uuid())
  userId        String              @unique
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String
  bio           String?
  countryId     String?
  country       Country?            @relation(fields: [countryId], references: [id])
  languages     String[]            @default([])
  dialects      String[]            @default([])
  role          CommunityRole       @default(MEMBER)
  status        CommunityUserStatus @default(ACTIVE) // separate from User.status -- a Community suspension must never suspend the main account
  postCount     Int                 @default(0)
  replyCount    Int                 @default(0)
  bookmarkCount Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  spaceMemberships CommunitySpaceMembership[]

  @@index([countryId])
  @@map("community_profiles")
}

/// Admin-managed topic container (General, Languages & Dialects, etc -- see
/// COMMUNITY-PLAN.md §8). Users cannot create spaces in MVP.
model CommunitySpace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  rules       String?
  isArchived  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships CommunitySpaceMembership[]
  posts       CommunityPost[]

  @@index([isArchived, sortOrder])
  @@map("community_spaces")
}

/// Simple join/leave membership -- no complex permissions in MVP (COMMUNITY-PLAN.md
/// §27). All standard spaces remain readable to every authenticated Community
/// member regardless of membership; this only personalizes "For You" and
/// marks joined spaces in the UI.
model CommunitySpaceMembership {
  id        String           @id @default(uuid())
  spaceId   String
  space     CommunitySpace   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  profileId String
  profile   CommunityProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([spaceId, profileId])
  @@map("community_space_memberships")
}

model CommunityPost {
  id         String              @id @default(uuid())
  authorId   String
  author     User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  spaceId    String
  space      CommunitySpace      @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  title      String
  slug       String              @unique
  body       String // sanitized HTML (rendered from Markdown at write time) -- see CommunityContentSanitizer
  status     CommunityPostStatus @default(PUBLISHED)
  isPinned   Boolean             @default(false)
  isLocked   Boolean             @default(false)
  viewCount  Int                 @default(0)
  replyCount Int                 @default(0)
  likeCount  Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  deletedAt  DateTime?

  tags        CommunityPostTag[]
  replies     CommunityReply[]
  reactions   CommunityReaction[]
  bookmarks   CommunityBookmark[]
  attachments CommunityAttachment[]
  reports     CommunityReport[]

  @@index([spaceId, status, createdAt])
  @@index([authorId])
  @@index([isPinned, spaceId])
  @@map("community_posts")
}

/// One level of nesting only (COMMUNITY-PLAN.md §14.3) -- a reply whose
/// parentReplyId already points at a non-null-parentReplyId reply is
/// rejected at the service layer, not the schema level (Prisma/Postgres
/// have no clean way to express "self-relation depth <= 1" as a constraint).
model CommunityReply {
  id            String               @id @default(uuid())
  postId        String
  post          CommunityPost        @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId      String
  author        User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentReplyId String?
  parentReply   CommunityReply?      @relation("CommunityReplyParent", fields: [parentReplyId], references: [id], onDelete: Cascade)
  childReplies  CommunityReply[]     @relation("CommunityReplyParent")
  body          String
  status        CommunityReplyStatus @default(PUBLISHED)
  likeCount     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  reactions   CommunityReaction[]
  attachments CommunityAttachment[]
  reports     CommunityReport[]

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentReplyId])
  @@map("community_replies")
}

model CommunityTag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())

  posts CommunityPostTag[]

  @@map("community_tags")
}

model CommunityPostTag {
  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    CommunityTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("community_post_tags")
}

/// Exactly one of postId/replyId is set -- enforced at the service layer.
/// Unique per user+target so a like always toggles rather than accumulates.
model CommunityReaction {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?
  post      CommunityPost?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  replyId   String?
  reply     CommunityReply?       @relation(fields: [replyId], references: [id], onDelete: Cascade)
  type      CommunityReactionType @default(LIKE)
  createdAt DateTime              @default(now())

  @@unique([userId, postId])
  @@unique([userId, replyId])
  @@map("community_reactions")
}

/// Private to the user -- never surfaced to the post's author or anyone else.
model CommunityBookmark {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, postId])
  @@map("community_bookmarks")
}

model CommunityAttachment {
  id           String                  @id @default(uuid())
  postId       String?
  post         CommunityPost?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  replyId      String?
  reply        CommunityReply?         @relation(fields: [replyId], references: [id], onDelete: Cascade)
  type         CommunityAttachmentType
  storageKey   String
  bucket       String
  mimeType     String
  size         Int
  originalName String
  createdAt    DateTime                @default(now())

  @@index([postId])
  @@index([replyId])
  @@map("community_attachments")
}

model CommunityNotification {
  id        String                    @id @default(uuid())
  userId    String
  user      User                      @relation("CommunityNotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type      CommunityNotificationType
  actorId   String?
  actor     User?                     @relation("CommunityNotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  postId    String?
  replyId   String?
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime                  @default(now())

  @@index([userId, readAt, createdAt])
  @@map("community_notifications")
}

/// targetId is polymorphic (a CommunityPost/CommunityReply/CommunityProfile
/// id depending on targetType) -- no FK, resolved by the service layer per
/// targetType, same posture as this schema's other polymorphic-target
/// models (e.g. Attachment's postId/replyId nullable-pair pattern doesn't
/// fit here since a report's target type is genuinely open-ended across
/// three different tables sharing no common parent).
model CommunityReport {
  id                  String                    @id @default(uuid())
  reporterId          String
  reporter            User                      @relation("CommunityReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType          CommunityReportTargetType
  targetId            String
  postId              String? // set only when targetType=POST, denormalized for a direct FK/index -- see below
  post                CommunityPost?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  replyId             String? // set only when targetType=REPLY
  reply               CommunityReply?           @relation(fields: [replyId], references: [id], onDelete: Cascade)
  reason              CommunityReportReason
  notes               String?
  status              CommunityReportStatus     @default(OPEN)
  assignedModeratorId String?
  assignedModerator   User?                     @relation("CommunityReportAssignedModerator", fields: [assignedModeratorId], references: [id], onDelete: SetNull)
  createdAt           DateTime                  @default(now())
  resolvedAt          DateTime?

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("community_reports")
}

/// Every moderator action must be logged (COMMUNITY-PLAN.md §24.4) --
/// targetId is polymorphic like CommunityReport.targetId, resolved by the
/// admin UI per targetType rather than a typed FK.
model CommunityModeratorAction {
  id          String                       @id @default(uuid())
  moderatorId String
  moderator   User                         @relation("CommunityModeratorActionModerator", fields: [moderatorId], references: [id], onDelete: Cascade)
  targetType  CommunityReportTargetType
  targetId    String
  action      CommunityModeratorActionType
  reason      String?
  metadata    Json?
  createdAt   DateTime                     @default(now())

  @@index([targetType, targetId])
  @@index([moderatorId, createdAt])
  @@map("community_moderator_actions")
}
